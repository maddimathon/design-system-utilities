---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */

/* import - functions */
import type { ComponentProps } from 'astro/types';
import { Tokens } from '../../ts/02-tokens/Tokens.js';
import { SampleTokens_Json } from '../functions/SampleTokens.js';

/* import - values */

/* import - components */
import LoremIpsumUtils from '@maddimathon/utility-astro/components/LoremIpsum';

/* import - layouts */

/* PROPS ===================================== */

export interface Props extends Omit<
    ComponentProps<typeof LoremIpsumUtils>,
    'displaySettings'
> {
    displaySettings?: Omit<
        ComponentProps<typeof LoremIpsumUtils>['displaySettings'],
        'buttonVariations' | 'headingLevels'
    >;
    tokens?: Tokens.JsonReturn;
}

const {
    displaySettings = {},
    tokens = SampleTokens_Json,
    ...props
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const headingLevels = Object.keys(tokens.typography.size.heading).map(Number);

const buttonVariations = tokens.themes['default']
    ? Object.keys(tokens.themes['default'].light['average'].data.button)
    : [];
---

<LoremIpsumUtils
    {...props}
    displaySettings={{
        ...displaySettings,
        buttonVariations,
        headingLevels,
    }}
>
    <slot />

    <slot
        name='one'
        slot='one'
    />
    <slot
        name='two'
        slot='two'
    />
    <slot
        name='three'
        slot='three'
    />
</LoremIpsumUtils>
