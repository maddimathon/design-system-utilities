---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */

/* import - values */
import { SampleTokens_Json } from '../functions/index.js';

/* import - components */
import { SettingsMenu as UtilsSettingsMenu } from '@maddimathon/utility-astro/components';

/* import - layouts */

/* PROPS ===================================== */

type Props = ComponentProps<typeof UtilsSettingsMenu> & {
    tokens?: Tokens.JsonReturn;
};

const { tokens = SampleTokens_Json, ...props }: Props = Astro.props;

/* CONSTANTS ===================================== */

const iconSVG =
    '<span class="icon icon--settings | settings-menu-icon">' +
    tokens.icons.settings.svgInlineLabelled.trim() +
    '</span>';
---

<UtilsSettingsMenu
    {...props}
    iconSVG={iconSVG}
>
    <slot
        name='settings-menu-open'
        slot='settings-menu-open'
    />
    <slot />
    <slot
        name='settings-menu-close'
        slot='settings-menu-close'
    />
</UtilsSettingsMenu>
