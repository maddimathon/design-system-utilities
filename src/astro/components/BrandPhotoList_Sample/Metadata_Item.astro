---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '@maddimathon/utility-astro';

import type {
    ButtonComponentType,
    HeadingComponentType,
} from '@maddimathon/utility-astro/components';

/* import - functions */
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

type Props  = ElementProps<{
    components?: Partial<{
        Button: ButtonComponentType;
        Heading: HeadingComponentType;
    }>;
    label: string;
    wrapItems?: boolean | ElementProps<{}, 'div'>;
}, 'dd'>

const {
    components,
    label,
    wrapItems = false,
    class: defClassList,
    ...defAttrs
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const {
    class: wrapItemClassList = [],
    ...wrapItemAttrs
} = wrapItems && typeof wrapItems === 'object' ? wrapItems : {};
---

{ wrapItems ? (
    <div {...wrapItemAttrs} class={makeClassList.flat(wrapItemClassList)}>
        <dt set:text={label} />
        <dd class={makeClassList.flat(defClassList ?? [])} {...defAttrs}><slot /></dd>
    </div>
) : (
    <dt set:text={label} />
    <dd class={makeClassList.flat(defClassList ?? [])} {...defAttrs}><slot /></dd>
) }


