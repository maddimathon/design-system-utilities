---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '@maddimathon/utility-astro';
import type {
    ButtonComponentType,
    HeadingComponentType,
} from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../../ts/02-tokens/@types.d.ts';
import type { Tokens } from '../../../ts/02-tokens/Tokens.js';

import type { PhotoData } from '../BrandPhoto.astro';

/* import - functions */

/* import - values */

/* import - components */
import {
    CopyToClipboardButton,
    Button as ButtonComponent,
    Heading as HeadingComponent,
    // VariableDump,
} from '@maddimathon/utility-astro/components';

import BrandPhotoList_Sample_Metadata_Caption from './Metadata_Caption.astro';
import BrandPhotoList_Sample_Metadata_Credit from './Metadata_Credit.astro';
import BrandPhotoList_Sample_Metadata_Files from './Metadata_Files.astro';
import BrandPhotoList_Sample_Metadata_Item from './Metadata_Item.astro';
import BrandPhotoList_Sample_Metadata_License from './Metadata_License.astro';
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export type BrandPhotoList_Sample_MetadataProps<
    T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams,
> = ElementProps<
    {
        components?: Partial<{
            Button: ButtonComponentType;
            Heading: HeadingComponentType;
        }>;

        copyCredit: undefined | boolean;

        displayHeading: undefined | number;

        data: PhotoData<
            | T_Types['photos']['photoSlugs']
            | T_Types['photos']['thumbnailSlugs']
        >;

        includeCaption: undefined | boolean;
        includeCaptionMeta: undefined | boolean;
        includeCredit: undefined | boolean;
        includeFiles: undefined | boolean;
        includeLicense: undefined | boolean;
        includeSource: undefined | boolean;

        spanColour: Tokens.JsonReturn<T_Types>['themes']['_meta']['keys']['text'][number];

        wrapItems: undefined | boolean | ElementProps<{}, 'div'>;
    },
    'dl'
>;

type Props = BrandPhotoList_Sample_MetadataProps<TokenTypes.TypeParams>;

const {
    class: classList,
    components: inputComponents,
    copyCredit = false,
    displayHeading = -1,
    data,
    includeCaption = false,
    includeCaptionMeta = !includeCaption,
    includeCredit = false,
    includeFiles = true,
    includeLicense = true,
    includeSource = includeCredit,
    spanColour,
    wrapItems,
    ...listAttrs
}: Props = Astro.props;

const components = {
    Button: inputComponents?.Button ?? ButtonComponent,
    Heading: inputComponents?.Heading ?? HeadingComponent,
};

/* CONSTANTS ===================================== */

const buttonSpacer =
    '<span class="brand-photo-list__sample__spacer">&NoBreak;&ensp;&NoBreak;</span>';

const { attrs, caption, meta, slug } = data;
---

<dl
    {...listAttrs}
    class={makeClassList.flat(classList ?? [])}
>
    {
        displayHeading < 0 && meta.label ? (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                label='Label'
            >
                <p set:text={meta.label} />
            </BrandPhotoList_Sample_Metadata_Item>
        ) : (
            slug && (
                <BrandPhotoList_Sample_Metadata_Item
                    {...{ components, wrapItems }}
                    label='Slug'
                >
                    <p>
                        <samp
                            class='display-inline'
                            set:text={slug}
                        />
                    </p>
                </BrandPhotoList_Sample_Metadata_Item>
            )
        )
    }

    {
        attrs.alt && (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                label='Alt Text'
            >
                <p>
                    <samp set:text={attrs.alt} />
                    <Fragment set:html={buttonSpacer} />
                    <CopyToClipboardButton
                        {...{ components }}
                        class='display-inline'
                        successMessage='copied!'
                        toClipboard={attrs.alt}
                        set:text='copy'
                    />
                </p>
            </BrandPhotoList_Sample_Metadata_Item>
        )
    }

    {
        includeCaptionMeta && caption && meta.credit && (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                label='Caption'
            >
                <BrandPhotoList_Sample_Metadata_Caption
                    {...{ buttonSpacer, components, data }}
                />
            </BrandPhotoList_Sample_Metadata_Item>
        )
    }

    {
        includeCredit &&
            (meta.credit || meta.attributionRequired !== false) && (
                <BrandPhotoList_Sample_Metadata_Item
                    {...{ components, wrapItems }}
                    label='Credit'
                >
                    <BrandPhotoList_Sample_Metadata_Credit
                        {...{ buttonSpacer, components, copyCredit, data }}
                    />
                </BrandPhotoList_Sample_Metadata_Item>
            )
    }

    {
        includeSource && meta.source && (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                label='Source'
            >
                <p>
                    <a
                        href={meta.source.href}
                        set:text={meta.source.label}
                        target='_blank'
                        rel='noreferrer noopener'
                    />
                </p>
            </BrandPhotoList_Sample_Metadata_Item>
        )
    }

    {
        includeLicense && meta.license && (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                label='License'
            >
                <BrandPhotoList_Sample_Metadata_License
                    {...{ components, data }}
                />
            </BrandPhotoList_Sample_Metadata_Item>
        )
    }

    {
        includeFiles && (
            <BrandPhotoList_Sample_Metadata_Item
                {...{ components, wrapItems }}
                class='brand-photo-list__sample__links'
                label='Files'
            >
                <BrandPhotoList_Sample_Metadata_Files
                    {...{ components, data, spanColour }}
                />
            </BrandPhotoList_Sample_Metadata_Item>
        )
    }
</dl>
