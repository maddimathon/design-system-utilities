---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */
import {
    objectMap,
    toTitleCase,
} from '@maddimathon/utility-typescript';
import { getLevelsInUse } from '../../ts/02-tokens/getLevelsInUse.js';

/* import - values */

/* import - components */
import {
    TableOfContents,
} from '@maddimathon/utility-astro/components';

import Alert from './Alert.astro';
import LoremIpsum from './LoremIpsum.astro';
import ThemeModeSwatch from './ThemeModeSwatch.astro';
import Toggle from './Toggle.astro';
import Widget from './Widget.astro';

/* import - layouts */

/* PROPS ===================================== */

interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> {
    tokens: Tokens.JsonReturn<T_Types>;

    defaultToggleToOpen?: boolean | `${"default"|T_Types['theme']['name']}-${TokenTypes.Theme.GetBrightnessKeys<T_Types['theme']>}`[];
}

const { defaultToggleToOpen: _defaultToggleToOpen, tokens }: Props = Astro.props;

/* FUNCTIONS ===================================== */

function getButtonVariations(themeKey: keyof typeof tokens.themes) {
    return tokens.themes[themeKey]
        ? Object.keys(tokens.themes[themeKey].light['average'].data.button)
        : [];
}

/* CONSTANTS ===================================== */

const themeNames = (
    Object.keys(tokens.themes) as ( keyof typeof tokens.themes )[]
).filter(name => name !== '_meta');

const hasMultipleThemes = themeNames.length > 1;

const defaultToggleToOpen = Array.isArray(_defaultToggleToOpen) ? _defaultToggleToOpen : !_defaultToggleToOpen ? null : _defaultToggleToOpen ?? ((!hasMultipleThemes && import.meta.env.DEV) ? true : null);

const levelsInUse = getLevelsInUse(tokens.themes);

const parsedSets = (
    Object.entries(tokens.themes) as [ keyof typeof tokens.themes, typeof tokens.themes[keyof typeof tokens.themes] ][]
).map(
    ([key,  theme]) => 
    key === '_meta'
    ? false
    : ({
        key,
        parsed: Object.values(
            objectMap(
                theme,
                ([brightness]) =>
                    brightness === '_name'
                        ? false
                        : brightness === '_meta'
                            ? false
                            :  brightness === 'forcedColours' 
                                ? false
                                : theme[brightness]
                                    ? {
                                        name: brightness,
                                        label: toTitleCase(`${key} — ${brightness} Mode`),
                                        href: `${key}-${brightness}-mode`,
                                        values: Object.values(
                                            objectMap(
                                                theme[brightness],
                                                ([ contrast,  theme ]): {
                                                    id: string,
                                                    brightness: "light"|"dark",
                                                    contrast: "low"|"average"|"high"|"max",
                                                    theme: typeof theme,
                                                } => ({
                                                    id: `theme-${key}-${contrast}`,
                                                    brightness,
                                                    contrast,
                                                    theme,
                                                })
                                            )
                                        ),
                                    }
                                    : false
            )
        ).filter((v) => v !== false),
    })
).filter((v) => v !== false);

const displayOptions = [
    {
        label: 'Preview',
        value: 'preview',
    },
    {
        label: 'Token values',
        value: 'tokens',
    },
] as const satisfies {
    label: string;
    value: string;
}[];

const themes_toc: ComponentProps<typeof TableOfContents>['menu'] = parsedSets.map(
    ( { parsed } ) => parsed.map(
        ( { label, href } ) => ( { label, href: `#${href}` } )
    )
).flat();
---

<p>
    The following colour shade levels are in use in at least one of the themes
    below: {
        Array.from( levelsInUse ).map( (level, i) =>
            i < levelsInUse.size - 1 ? (
                <Fragment set:html={`<code>${level}</code>, `} />
            ) : (
                <Fragment set:html={`and <code>${level}</code>.`} />
            )
        )
    }
</p>

<div
    aria-ignore="true"
    class="theme-mode-preview-page__display-mode__wrapper"
>Display themes as: 
{ displayOptions.map( ( { label, value } ) => (
    <label class='theme-mode-preview-page__display-mode__label'><input 
        type='radio'
        class='theme-mode-preview-page__display-mode__label'
        name='theme-mode-preview-page__display-mode-control'
        value={value}
    /> {label}</label>
) ) }</div>

<TableOfContents
    asToggle={false}
    convertHrefStringsToAbsolute={false}
    heading={2}
    menu={themes_toc}
    ToggleComponent={Toggle}
    toggleProps={{ tokens }}
/>

{
    parsedSets.map(({ key, parsed }) => (
        <h2 
            class='screen-reader-text'
            set:text={`${toTitleCase(key)} Theme`}
        />
        <Fragment>
            {parsed.map((brightnessSet) => ( 
                <Toggle
                    class='theme-mode-toggle'
                    defaultOpen={defaultToggleToOpen === true || defaultToggleToOpen?.includes( `${key}-${brightnessSet.name}` )} 
                    displayHeading={2}
                    heading={3} 
                    id={brightnessSet.href}
                >
                    <Fragment 
                        set:text={brightnessSet.label}
                        slot='button'
                    />
                    { displayOptions.map( ( opt ) => (
                        <div
                            class:list={ [
                                'theme-mode-toggle__list', 
                            ] }
                            data-theme-mode-preview-page-display-mode-content={opt.value}
                            style={`--theme-mode-swatch-list-column-count: ${brightnessSet.values.length};`}
                        >
                            { brightnessSet.values.map((set) => (
                                <ThemeModeSwatch
                                    {...set}
                                    brightness={brightnessSet.name}
                                    data-active-theme={key == 'default' ? undefined : key}
                                    displayHeading={3}
                                    displayMode={opt.value}
                                    heading={4}
                                    id={`${set.id}-swatch`}
                                    tokens={tokens}
                                >
                                    <Fragment
                                        slot='heading'
                                        set:text={`${toTitleCase(set.contrast)} Contrast`}
                                    />
                                    { Object.keys(set.theme.data.background).length > 1 && (
                                        <div class="theme-mode-swatch__alt-widgets" slot="preview">
                                            { Object.entries(set.theme.data.background).map(
                                                ([backgroundSlug, backgroundClrName]) => backgroundSlug !== '$' &&(
                                                    // displayHeading={3}
                                                    <Alert
                                                        class:list={`alert-block--${backgroundSlug} background-${backgroundSlug}`}
                                                        icon={ tokens.icons[backgroundSlug] ?? tokens.icons.star }
                                                        style={`background: var(--theme-background-${backgroundSlug}, var(--clr-${backgroundClrName}))`}
                                                    >
                                                        <Fragment slot='headline'>Alert Block: <samp set:text={`background-${backgroundSlug}`} /></Fragment>
                                                        <LoremIpsum
                                                            displayHeading={7}
                                                            heading={5}
                                                            mode={ import.meta.env.DEV ? 'library' : 'minimum' }
                                                            superAbbreviated={true}
                                                            tokens={tokens}
                                                        />
                                                    </Alert>
                                                )
                                            ) }
                                        </div>
                                    ) }
                                    { hasMultipleThemes && key == 'default' && (
                                        <div class="site-sidebar theme-mode-swatch__alt-widgets" slot="preview">
                                            { themeNames.map(
                                                ( themeName ) => themeName !== key && (
                                                    <Widget
                                                        displayHeading={3}
                                                        heading={5} 
                                                        class:list={'widget-block--alt-theme'}
                                                        data-active-theme={themeName}
                                                        data-brightness-mode={brightnessSet.name}
                                                        data-contrast-mode={set.contrast}
                                                    >
                                                        <Fragment slot='heading'>Theme Demo Widget</Fragment>
                                                        <Fragment slot='subtitle'>This is the <samp set:text={toTitleCase(themeName)} /> theme</Fragment>
                                                        <LoremIpsum
                                                            displayHeading={4}
                                                            displaySettings={ { 
                                                                buttons: false,
                                                                buttonTypes: false,
                                                                buttonVariationsAll: false,
                                                                disabledButton: false,
                                                            } }
                                                            heading={6}
                                                            mode={ import.meta.env.DEV ? 'fancy' : 'library' }
                                                            superAbbreviated={true}
                                                            tokens={tokens}
                                                        />
                                                        <Fragment slot="cta-buttons">{ getButtonVariations( themeName ).map(
                                                            variant => ( variant === 'primary' || variant === 'secondary' || variant === 'tertiary' ) && <button
                                                                class={`button-${variant}`}
                                                                set:text={`This is a ${variant} CTA button`}
                                                                type="button"
                                                            />
                                                        ) }</Fragment>
                                                    </Widget>
                                                )
                                            ) }
                                        </div>
                                    ) }
                                </ThemeModeSwatch>
                            )) }
                        </div>
                    ) ) }
                </Toggle>
            ))}
        </Fragment>
    ))
}

<style lang='scss'>
    @forward '../scss/page-content-theme';
</style>