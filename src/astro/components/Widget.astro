---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '@maddimathon/utility-astro';

/* import - functions */

/* import - values */

/* import - components */
import { Heading } from '@maddimathon/utility-astro/components';

/* import - layouts */

/* PROPS ===================================== */

interface Props extends ElementProps<{}, 'section'> {
    children: any[];

    /**
     * If any, the heading display level override for this heading (otherwise
     * the `heading` value is used).
     */
    displayHeading?: number;

    heading: number;

    /**
     * @since 0.1.0-alpha.4
     */
    hideHeading?: boolean;

    style?: string;
}

const {
    class: classList,
    displayHeading,
    heading,
    hideHeading = false,
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const ctaButtonsHTML =
    Astro.slots.has('cta-buttons') &&
    (await Astro.slots.render('cta-buttons'))?.trim();

const headingHTML =
    Astro.slots.has('heading') && (await Astro.slots.render('heading'))?.trim();

const subtitleHTML =
    Astro.slots.has('subtitle') &&
    (await Astro.slots.render('subtitle'))?.trim();
---

{
    (headingHTML || subtitleHTML) && (
        <section
            {...attributes}
            class:list={['widget-block', { '||': classList }, classList]}
        >
            <slot name='prefix' />

            {headingHTML && (
                <header
                    class:list={[
                        'widget-block__header',
                        hideHeading && 'screen-reader-text',
                    ]}
                >
                    <Heading
                        attrs={{
                            hgroup: { class: 'widget-block__hgroup' },
                            subheading: { class: 'widget-block__subtitle' },
                        }}
                        class:list='widget-block__title'
                        displayHeading={displayHeading}
                        heading={heading}
                        set:html={headingHTML}
                    >
                        <Fragment
                            slot='subheading'
                            set:html={subtitleHTML}
                        />
                    </Heading>
                </header>
            )}

            <div class='widget-block__content'>
                <slot />
            </div>

            {ctaButtonsHTML && (
                <div
                    class='button-span | widget-block__button-span'
                    set:html={ctaButtonsHTML}
                />
            )}
        </section>
    )
}
