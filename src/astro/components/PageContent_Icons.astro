---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { PartialExcept } from '@maddimathon/utility-typescript/types';
import type { ToggleProps } from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../ts/02-tokens/@types.d.ts';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';
import type { Tokens_Icons } from '../../ts/02-tokens/Tokens_Icons';

import type  { LoremIpsumProps } from './LoremIpsum.astro';

/* import - functions */
import { arrayUnique } from '@maddimathon/utility-typescript';
import { objectKeySort_Tokens } from '../../ts/01-utilities/objectKeySort_Tokens.js';

/* import - values */

/* import - components */
import {
    CopyToClipboardButton,
    Heading,
} from '@maddimathon/utility-astro/components';

import Alert from './Alert.astro';
import Icon from './Icon.astro';
import IconFontTester from './IconFontTester.astro';
import LoremIpsum from './LoremIpsum.astro';
import Toggle from './Toggle.astro';

/* import - layouts */

/* PROPS ===================================== */

interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> {
    alignmentIcon?: T_Types['iconNames'];
    defaultIcon?: T_Types['iconNames'];
    inlinePreviews?: boolean;
    inlinePreviews_defaultOpen?: boolean;
    logoAlerts?: boolean;
    buttonColour?: Tokens.JsonReturn<T_Types>['themes']['_meta']['keys']['button'][number];
    subheadingDisplayHeading?: number;
    tokens: Tokens.JsonReturn<T_Types>;

    /**
     * @since ___PKG_VERSION___
     */
    LoremIpsumComponent?: ( props: Partial<LoremIpsumProps> ) => any;

    /**
     * @since ___PKG_VERSION___
     */
    ToggleComponent?: ( props: PartialExcept<ToggleProps,  'children'|'id' > ) => any;
}

const {
    alignmentIcon,
    buttonColour = 'grey',
    defaultIcon,
    inlinePreviews = import.meta.env.DEV,
    inlinePreviews_defaultOpen = import.meta.env.DEV,
    logoAlerts = import.meta.env.DEV,
    subheadingDisplayHeading = 6,
    tokens,

    LoremIpsumComponent = LoremIpsum,
    ToggleComponent = Toggle,
}: Props = Astro.props;

/* FUNCTIONS ===================================== */

// const iconSlugSorter = (
//     a: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>,
//     b: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>,
// ) => {
//     const sort_a = a.slug.toLowerCase();
//     const sort_b = b.slug.toLowerCase();

//     if ( sort_a > sort_b ) {
//         return 1;
//     }

//     if ( sort_a < sort_b ) {
//         return -1;
//     }

//     return 0;
// }

const labelSlugSorter = (
    a: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>,
    b: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>,
) => {
    const sort_a = a.label.toLowerCase();
    const sort_b = b.label.toLowerCase();

    if ( sort_a > sort_b ) {
        return 1;
    }

    if ( sort_a < sort_b ) {
        return -1;
    }

    return 0;
}

/* CONSTANTS ===================================== */

const defaultToggleToOpen = import.meta.env.DEV ? true : undefined;

const alignmentIconSvg = tokens.icons[alignmentIcon ?? 'group'] ?? tokens.icons.group ?? tokens.icons.fail;

const defaultIconSvg = tokens.icons[defaultIcon ?? alignmentIcon ?? 'star'] ?? tokens.icons.group ?? tokens.icons.star;

const textAndBackgroundKeys = arrayUnique([
    ...tokens.themes._meta.keys.background,
    ...tokens.themes._meta.keys.text,
]).sort(objectKeySort_Tokens.sorter);

const iconsSortedByLabel = Object.entries(tokens.icons).sort(
    ( a, b ) => labelSlugSorter( a[1], b[1] )
)

let _defaultIcons: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>[] = [];
let _customicons: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>[] = [];
let _logoIcons: Tokens_Icons.Local_SvgMaker.JsonReturn<string, string>[] = [];

iconsSortedByLabel.forEach( ([__key, icon]) => {

    // returns
    if (icon.slug.match(/^logo-/gi) !== null) {
        _logoIcons.push(icon);
        return;
    }

    // returns
    if (icon.meta?.isDefault === true) {
        _defaultIcons.push(icon);
        return;
    }
        
    _customicons.push(icon);
} );

const customicons = _customicons.sort(labelSlugSorter);
const defaultIcons = _defaultIcons.sort(labelSlugSorter);
const logoIcons = _logoIcons.sort(labelSlugSorter);
---

<h2>All Icons</h2>

<ul class='button-span | tokens-demo-all-icons tokens-demo-all-icons--basic'>
    {
        defaultIcons.map(
            (icon) => !icon.meta?.aliasOf?.length ? <li><Icon icon={icon} /></li> : ''
        )
    }
</ul>

{ logoIcons.length ? (
    <Heading
        displayHeading={subheadingDisplayHeading}
        heading={3}
    >External Logo Icons</Heading>
    <ul class='button-span | tokens-demo-all-icons tokens-demo-all-icons--basic tokens-demo-all-icons--logo'>
        {
            logoIcons.map(
                (icon) => !icon.meta?.aliasOf?.length ? <li><Icon icon={icon} /></li> : ''
            )
        }
    </ul>
) : '' }

{ customicons.length ? (
    <Heading
        displayHeading={subheadingDisplayHeading}
        heading={3}
    >Customized Icons</Heading>
    <ul class='button-span | tokens-demo-all-icons tokens-demo-all-icons--basic tokens-demo-all-icons--custom'>
        {
            customicons.map(
                (icon) => !icon.meta?.aliasOf?.length ? <li><Icon icon={icon} /></li> : ''
            )
        }
    </ul>
) : '' }

{
    inlinePreviews && (
        <Alert icon={tokens.icons.info ?? tokens.icons.star} class="background-bright">
            <p>You can use utility classes to add inline icons to HTML text. Find the slug in the list of alerts below and choose from <samp set:text="add-[slug]-icon-before" /> or <samp set:text="add-[slug]-icon-after" />.</p>
        </Alert>
        
        <ToggleComponent
            class:list={ import.meta.env.DEV ? 'page-width' : '' }
            defaultOpen={inlinePreviews_defaultOpen}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="pseudo-icons-preview"
        >
            <Fragment slot='button' set:text='Inline Icons Preview' />
            
            <ul class={'tokens-demo-all-icons-inline' + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class={'button-span tokens-demo-all-icons-inline--icon-list' + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}>
                            {/* <li
                                class={`add-${icon.slug}-icon`}
                                set:text={`${icon.label} Default`}
                            /> */}
                            <li
                                class={`add-${icon.slug}-icon-before`}
                                set:text={`${icon.label} Before`}
                            />
                            <li
                                class={`add-${icon.slug}-icon-after`}
                                set:text={`${icon.label} After`}
                            />
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </ToggleComponent>
    
        <ToggleComponent
            class:list={ import.meta.env.DEV ? 'page-width' : '' }
            defaultOpen={inlinePreviews_defaultOpen}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="button-inline-icons-preview"
        >
            <Fragment slot='button' set:text='Button Inline Icons Preview' />
            <ul class='tokens-demo-all-icons-inline tokens-demo-all-icons-inline--buttons'>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class='button-span tokens-demo-all-icons-inline--icon-list'>
                            {/* <li>
                                <a
                                    class={`button | add-${icon.slug}-icon`}
                                    href='#'
                                    set:text={`${icon.label} Default`}
                                />
                            </li> */}

                            <li>
                                <a
                                    class={`button | add-${icon.slug}-icon-before` + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}
                                    href='#'
                                    set:text={`${icon.label} Before`}
                                />
                            </li>

                            <li>
                                <a
                                    class={`button | add-${icon.slug}-icon-after` + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}
                                    href='#'
                                    set:text={`${icon.label} After`}
                                />
                            </li>
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </ToggleComponent>
    
        <ToggleComponent
            class:list={ import.meta.env.DEV ? 'page-width' : '' }
            defaultOpen={inlinePreviews_defaultOpen}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="button-embedded-icons-preview"
        >
            <Fragment slot='button' set:text='Button Embedded Icons Preview' />
            <ul class='tokens-demo-all-icons-inline tokens-demo-all-icons-inline--buttons tokens-demo-all-icons-inline--buttons-embedded'>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class='button-span tokens-demo-all-icons-inline--icon-list'>

                            <li>
                                <a
                                    aria-label={icon.label} 
                                    class='button'
                                    href='#'
                                ><Icon icon={icon} /></a>
                            </li>

                            <li>
                                <a
                                    class={'button' + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}
                                    href='#'
                                ><Icon icon={icon} /><span set:text={`${icon.label} Before`} /></a>
                            </li>

                            <li>
                                <a
                                    class={'button' + ( import.meta.env.DEV ? ' font-size-heading-5' : '' )}
                                    href='#'
                                ><span set:text={`${icon.label} After`} /><Icon icon={icon} /></a>
                            </li>
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </ToggleComponent>
    )
}

<Heading
    heading={2}
    set:text='All Alert Blocks'
/>
<IconFontTester />

<div class='site-width | tokens-demo-all-alerts tokens-demo-all-alerts--basic'>
    {
        defaultIcons.map((icon) => (
            <Alert icon={icon}>
                <Fragment
                    slot='headline'
                    set:text={icon.label}
                />
                <p>slug: <samp set:text={icon.slug} /></p>
                { icon.meta?.aliasOf && <p class="aside">is a copy of <samp set:text={icon.meta.aliasOf} /></p> }
                { icon.meta?.codepoint && <p class="aside">font glyph: <samp
                    set:text={`U+${icon.meta.codepoint.toString(16).toUpperCase()}`}
                />&NoBreak;&ensp;<CopyToClipboardButton
                    class:list={`button-${buttonColour} display-inline`}
                    successMessage='copied!'
                    toClipboard={String.fromCharCode(icon.meta.codepoint)}
                    set:text='copy'
                /></p> }
            </Alert>
        ))
    }
</div>

{ logoAlerts && logoIcons.length ? (
    <Heading
        displayHeading={subheadingDisplayHeading}
        heading={3}
    >Alerts with External Logo Icons</Heading>
    <div class='site-width | tokens-demo-all-alerts tokens-demo-all-alerts--custom'>
        {
            logoIcons.map(
                (icon) => (
                    <Alert icon={icon}>
                        <Fragment
                            slot='headline'
                            set:text={icon.label}
                        />
                        <p>slug: <samp set:text={icon.slug} /></p>
                        { icon.meta?.aliasOf && <p class="aside">is a copy of <samp set:text={icon.meta.aliasOf} /></p> }
                        { icon.meta?.codepoint && <p class="aside">font glyph: <samp
                            set:text={`U+${icon.meta.codepoint.toString(16).toUpperCase()}`}
                        />&NoBreak;&ensp;<CopyToClipboardButton
                            class:list={`button-${buttonColour} display-inline`}
                            successMessage='copied!'
                            toClipboard={String.fromCharCode(icon.meta.codepoint)}
                            set:text='copy'
                        /></p> }
                    </Alert>
                )
            )
        }
    </div>
) : '' }

{ customicons.length ? (
    <Heading
        displayHeading={subheadingDisplayHeading}
        heading={3}
    >Alerts with Customized Icons</Heading>
    <div class='site-width | tokens-demo-all-alerts tokens-demo-all-alerts--custom'>
        {
            customicons.map(
                (icon) => (
                    <Alert icon={icon}>
                        <Fragment
                            slot='headline'
                            set:text={icon.label}
                        />
                        <p>slug: <samp set:text={icon.slug} /></p>
                        { icon.meta?.aliasOf && <p class="aside">is a copy of <samp set:text={icon.meta.aliasOf} /></p> }
                        { icon.meta?.codepoint && <p class="aside">font glyph: <samp
                            set:text={`U+${icon.meta.codepoint.toString(16).toUpperCase()}`}
                        />&NoBreak;&ensp;<CopyToClipboardButton
                            class:list={`button-${buttonColour} display-inline`}
                            successMessage='copied!'
                            toClipboard={String.fromCharCode(icon.meta.codepoint)}
                            set:text='copy'
                        /></p> }
                    </Alert>
                )
            )
        }
    </div>
) : '' }

<ToggleComponent
    defaultOpen={defaultToggleToOpen}
    displayHeading={subheadingDisplayHeading}
    heading={3}
    id={`tokens-demo-alert-headings`}
>
    <Fragment
        set:text='All Alert Heading Levels'
        slot='button'
    />
    {
        Object.keys(tokens.typography.size.heading)
            .map(Number)
            .map((heading) => (
                <Alert
                    heading={heading}
                    minimumHeading={1}
                    icon={alignmentIconSvg}
                >
                    <Fragment
                        slot='headline'
                        set:text={`Heading Level ${heading}`}
                    />
                    <p set:text='Aenean dictum commodo ex, eleifend malesuada nibh rhoncus at. Vivamus non lectus eu turpis aliquet pretium. Cras metus urna, tincidunt at scelerisque sit amet, tincidunt vitae risus.' />
                    <p set:text='Vivamus sed commodo ligula, nec efficitur elit. Praesent condimentum diam est, sit amet venenatis sapien ullamcorper sit amet.' />
                </Alert>
            ))
    }
    <Alert icon={alignmentIconSvg}>
        <Fragment
            slot='headline'
            set:text={`NO Heading Level`}
        />
        <p
            set:text='Aenean dictum commodo ex, eleifend malesuada nibh rhoncus at. Vivamus non lectus eu turpis aliquet pretium. Cras metus urna, tincidunt at scelerisque sit amet, tincidunt vitae risus.'
        />
        <p
            set:text='Vivamus sed commodo ligula, nec efficitur elit. Praesent condimentum diam est, sit amet venenatis sapien ullamcorper sit amet.'
        />
    </Alert>
</ToggleComponent>

<ToggleComponent
    defaultOpen={defaultToggleToOpen}
    displayHeading={subheadingDisplayHeading}
    heading={3}
    id={`tokens-demo-alert-colours`}
>
    <Fragment
        set:text='All Colour Variations'
        slot='button'
    />
    <Alert icon={defaultIconSvg}>
        <Fragment
            slot='headline'
            set:text={`Default Colour Variation`}
        />
        <LoremIpsumComponent superAbbreviated={true} />
    </Alert>
    {
        textAndBackgroundKeys.map((key) => (
            <Alert
                icon={tokens.icons[key] ?? defaultIconSvg}
                class:list={`background-${key}`}
            >
                <Fragment slot='headline'>
                    Colour Variation: <samp set:text={key} />
                </Fragment>
                <LoremIpsumComponent superAbbreviated={true} />
            </Alert>
        ))
    }
</ToggleComponent>

<style lang='scss'>
    @forward '../scss/page-content-icons';
</style>
