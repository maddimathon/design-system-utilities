---
/**
 * @since ___PKG_VERSION___
 *
 * @packageDocumentation
 */

/* import - types */
import type { TokenTypes } from '../../ts/02-tokens/@types.d.ts';

import type { BrandPhotoList_Sample_MetadataProps } from './BrandPhotoList_Sample/index.js';

import type {
    AllPhotos,
    AllThumbnails,
    BrandPhotoProps,
    BrandPhotoProps_Linked,
} from './BrandPhoto.astro';

/* import - functions */

/* import - values */

/* import - components */
import BrandPhoto from './BrandPhoto.astro';
import { BrandPhotoList_Sample_Metadata } from './BrandPhotoList_Sample/index.js';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

// prettier-ignore
interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> extends BrandPhotoList_Sample_MetadataProps<T_Types> {
    
    defineSize: undefined | boolean;
    
    photos: AllPhotos<T_Types>;
    thumbnails: AllThumbnails<T_Types>;

    urlMaker: (currentURL: URL, targetSubpath: string) => string;
}

const {
    defineSize,
    displayHeading = -1,
    data,
    includeCaption = false,
    photos,
    thumbnails,
    urlMaker,
    ...metadataProps
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const linkProps = data.attrs.src
    ? ({
          href: data.attrs.src,
          linkAttrs: {
              'class:list': [
                  'brand-photo-list__sample__img',
                  `brand-photo-list__sample__img--${data.slug}`,
                  {
                      'brand-photo-list__sample__img--hidden-heading':
                          displayHeading < 0,
                  },
              ],
              'target': '_blank',
          },
          linkLabel: 'open image in new tab',
      } satisfies Pick<
          BrandPhotoProps_Linked,
          'href' | 'linkAttrs' | 'linkLabel'
      >)
    : {};

const photoProps = {
    defineSize,
    includeCaption,
    photos,
    slug: data.slug,
    thumbnails,
    urlMaker,
    ...linkProps,

    linkAttrs: {
        ...linkProps.linkAttrs,
    },
} satisfies BrandPhotoProps;
---

<BrandPhoto {...photoProps} />

<BrandPhotoList_Sample_Metadata
    class:list='brand-photo-list__sample__meta'
    {...{
        ...metadataProps,
        displayHeading,
        data,
        includeCaption,
    }}
/>
