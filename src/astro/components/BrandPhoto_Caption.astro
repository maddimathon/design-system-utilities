---
import type { PhotoData } from './BrandPhoto';

/**
 * @since ___PKG_VERSION___
 *
 * @packageDocumentation
 */

/* import - types */

/* import - functions */

/* import - values */

/* import - components */

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

export interface Props {
    meta: PhotoData<string>['meta'];
}

const { meta }: Props = Astro.props;

/* CONSTANTS ===================================== */
---

{
    typeof meta.credit === 'object' ? (
        <Fragment>
            {'Photo by '}
            <a
                href={meta.credit.href}
                set:text={meta.credit.label}
                target='_blank'
            />
        </Fragment>
    ) : (
        (meta.credit ?? '')
    )
}
{meta.source ? (meta.credit ? ` via ` : `From `) : ''}
{
    meta.source && (
        <a
            href={meta.source.href}
            set:text={meta.source.label}
            target='_blank'
        />
    )
}
{(meta.source || meta.credit) && '.'}
