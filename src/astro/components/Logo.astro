---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLTag } from 'astro/types';

import type { ClassList, ElementProps } from '@maddimathon/utility-astro';
import type { DynamicWrapperProps } from '@maddimathon/utility-astro/components';

import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import components from '@maddimathon/utility-astro/components';
import { makeClassList } from '@maddimathon/utility-astro/functions';
const { DynamicWrapper } = components;

/* import - layouts */

/* PROPS ===================================== */

export type LogoProps<T_Tag extends HTMLTag = HTMLTag> = Omit<
    DynamicWrapperProps<T_Tag>,
    'children'
> & {
    logo: SvgMaker.JsonReturn;
    class?: ClassList;
};

type Props = ElementProps<LogoProps, 'div'>;

const {
    'aria-hidden': ariaHidden = false,
    'class': classList = [],
    logo,
    tag = 'div',
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */
---

<DynamicWrapper
    {...attributes}
    aria-hidden={ariaHidden ? true : undefined}
    class={makeClassList(['brand-logo', `brand-logo--${logo.slug}`], classList)}
    tag={tag}
>
    <Fragment
        set:html={ariaHidden
            ? logo.svgInlineHidden.trim()
            : logo.svgInlineLabelled.trim()}
    />
</DynamicWrapper>
