---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { Classify } from '@maddimathon/utility-typescript/types';

import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';
import type { Tokens_Colour_ShadeMap } from '../../ts/02-tokens/Colour/Colour_ShadeMap.js';
import type { ShadeSwatchTableProps } from './ShadeSwatchTable.astro';

/* import - functions */
import { mergeArgs, toTitleCase } from '@maddimathon/utility-typescript';
import { ColourUtilities } from '../../ts/01-utilities/ColourUtilities.js';
import { getLevelsInUse } from '../../ts/02-tokens/getLevelsInUse.js';
import { makeShadeTargetLevels } from '../functions/makeShadeTargetLevels.js';

/* import - values */

/* import - components */
import {
    Heading,
    TableOfContents,
} from '@maddimathon/utility-astro/components';

import ShadeSwatchAllLists from './ShadeSwatchAllLists.astro';
import ShadeSwatchTable from './ShadeSwatchTable.astro';
import Toggle from './Toggle.astro';

/* import - layouts */

/* PROPS ===================================== */

interface Props<
    T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams,
> {
    tokens: Tokens.JsonReturn<T_Types>;

    /**
     * @since ___PKG_VERSION___ - Combined include.colourFormats, includeOnlyUsedLevels, and includeTargetLevels into this prop.
     */
    include?: {

        /**
         * Whether to include the given colour formats in the the shade swatch table.
         *
         * @since 0.1.0-alpha.4
         * @since ___PKG_VERSION___ — Moved into include.
         */
        colourFormats?: undefined|{
            hex?: boolean;
            hsl?: boolean;
            lch?: boolean;
            rgb?: boolean;
        };

        lists?: boolean;

        table?: boolean;

        tableOfContents?: boolean | null;

        /** 
         * @since 0.1.0-alpha.4
         * @since ___PKG_VERSION___ — Moved into include. Added undefined option.
         */
        targetLevels?: undefined | boolean;
        
        /** 
         * @since 0.1.0-alpha.4
         * @since ___PKG_VERSION___ — Moved into include.
         */
        onlyUsedLevels?: boolean;
    };

    /**
     * Used to pass custom targets to the shade swatch table.
     *
     * @since 0.1.0-alpha.4
     */
    yardstick?:
        | Tokens_Colour_ShadeMap.JsonReturn<T_Types['colour']>
        | {
              base: Tokens_Colour_ShadeMap.JsonReturn<T_Types['colour']>;

              /**
               * Colour name to use to find target contrast from base shades.
               */
              accent?: string | Tokens_Colour_ShadeMap.JsonReturn<T_Types['colour']>;
          };
}

const {
    include: _include,
    tokens,
    yardstick,
}: Props = Astro.props;

const include = mergeArgs(
    {
        colourFormats: undefined,
        lists: true,
        onlyUsedLevels: !import.meta.env.DEV,
        table: true,
        tableOfContents: null,
        targetLevels: undefined,
    } satisfies Classify<NonNullable<Props['include']>>,
    _include,
);

/* FUNCTION ===================================== */

/* CONSTANTS ===================================== */

const allLevels = Object.keys(tokens.colour.base) as (
    | ColourUtilities.Levels.Required
    | ColourUtilities.Levels.Optional
)[];

const levelsInUse = getLevelsInUse(tokens.themes);

const excludeLevels = !include.onlyUsedLevels
    ? []
    : allLevels.filter((level) => !levelsInUse.has(level));

const yardsticks = yardstick
    ? 'base' in yardstick
        ? ( yardstick.base ? yardstick : undefined )
        : ( yardstick ? { base: yardstick } : undefined )
    : undefined;

const levelTargets = yardsticks?.base ? {
    base: await makeShadeTargetLevels('base', yardsticks.base),
    accent: yardsticks?.accent 
        ? typeof yardsticks.accent === 'object'
            ? await makeShadeTargetLevels(
                'accent',
                yardsticks.accent ?? yardsticks.base,
            ) 
            : await makeShadeTargetLevels(
                yardsticks.accent,
                tokens.colour[yardsticks.accent] ?? yardsticks.base,
            ) 
        : undefined,
} : undefined;

const shadeList_toc: ComponentProps<typeof TableOfContents>['menu'] =
    include.tableOfContents
        ? [
              include.table
                  ? {
                        label: 'Shade Table',
                        href: '#all-colours',
                    }
                  : null,

              ...(include.lists
                  ? Object.entries(tokens.colour)
                        .filter(([name]) => name !== '$')
                        .map(([name]) => ({
                            label: `${toTitleCase(name)} Shade Details`,
                            href: `#shades-${name}`,
                        }))
                  : []),
          ].filter((val) => val !== null)
        : [];

const baseShades: ShadeSwatchTableProps['colour']['base'] = {
    ...tokens.colour.base,
    ...tokens.colour.$,
};

const allColours = {
    ...tokens.colour,
    base: baseShades,
} as ShadeSwatchTableProps['colour'];
---

{
    include.tableOfContents && shadeList_toc.length > 1 && (
        <TableOfContents
            asToggle={false}
            convertHrefStringsToAbsolute={false}
            heading={2}
            menu={shadeList_toc}
            ToggleComponent={Toggle}
            toggleProps={{ tokens }}
        />
    )
}

{include.table && (
    <Heading
        class='screen-reader-text'
        heading={2}
        set:text='contrast targets'
    />
    <ShadeSwatchTable
        heading={3}
        id='all-colours'
        colour={allColours}
        excludeLevels={excludeLevels}
        includeColourFormats={include.colourFormats}
        includeTargetLevels={include.targetLevels}
        targets={levelTargets}
        targetShades={yardsticks && {
            base: yardsticks?.base,
            accent: typeof yardsticks?.accent === 'object' ? yardsticks.accent : (tokens.colour[ yardsticks.accent ?? 'base' ] ?? yardsticks.base),
        }}
        tokens={tokens}
    />
)}

{include.lists && <ShadeSwatchAllLists tokens={tokens} />}