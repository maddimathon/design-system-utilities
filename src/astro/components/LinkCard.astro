---
/**
 * @since ___PKG_VERSION___
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { PartialPick } from '@maddimathon/utility-typescript/types';

import type { ElementProps } from '@maddimathon/utility-astro';
import type {
    DynamicWrapperComponentType,
    DynamicWrapperProps,
    HeadingComponentType,
    HeadingProps,
} from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

import type { IconComponentType } from './Icon.astro';

/* import - functions */
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - values */
import { SampleTokens_Json } from '../functions.js';

/* import - components */
import {
    DynamicWrapper,
    Heading as HeadingComponent,
} from '@maddimathon/utility-astro/components';

import IconComponent from './Icon.astro';

/* import - layouts */
// import {} from '@maddimathon/utility-astro/layouts';

/* TYPES ===================================== */

/* FUNCTIONS ===================================== */

export function getLinkCardIds<T extends string>(id: T) {
    return {
        container: id,
        heading: `${id}-heading`,
    } as const;
}

/* PROPS ===================================== */

export type LinkCardProps<T_Types extends TokenTypes.TypeParams> = ElementProps<
    {
        tokens?: undefined | Tokens.JsonReturn<T_Types>;

        href: string;
        id: string;

        activeTheme?: Exclude<
            keyof Tokens.JsonReturn<T_Types>['themes'],
            '_meta'
        >;
        background?: Tokens.JsonReturn<T_Types>['themes']['_meta']['keys']['background'][number];

        /**
         * The base for class names.
         */
        classBase?: string;

        components?: Partial<{
            CardContainer: DynamicWrapperComponentType;
            Container: DynamicWrapperComponentType;
            Heading: HeadingComponentType;
            Icon: IconComponentType;
        }>;

        displayHeading?: HeadingProps['displayHeading'];
        heading?: HeadingProps['heading'];

        /**
         * Number of tag slots to check for.
         */
        maxTags?: number;

        readMoreText?: string;
    },
    'div'
>;

export type LinkCardPropsPartial<T_Types extends TokenTypes.TypeParams> =
    PartialPick<
        LinkCardProps<T_Types>,
        'classBase' | 'components' | 'readMoreText' | 'tokens'
    >;

export type LinkCardComponentType = (
    props: LinkCardPropsPartial<TokenTypes.TypeParams>,
) => any;

type Props = LinkCardProps<TokenTypes.TypeParams>;

const {
    activeTheme,
    background,
    class: classList,
    classBase = 'link-card',
    components: {
        Container = DynamicWrapper,
        CardContainer = DynamicWrapper,
        Heading = HeadingComponent,
        Icon = IconComponent,
    } = {},
    displayHeading,
    heading = 0,
    href,
    id,
    maxTags = 10,
    readMoreText = 'Read More',
    tokens = SampleTokens_Json,
    ...attrs
} = Astro.props as Props;

/* CONSTANTS ===================================== */

const html = {
    content: (await Astro.slots.render('default'))?.trim(),
    date: (await Astro.slots.render('date'))?.trim(),
    description: (await Astro.slots.render('description'))?.trim(),
    footer: (await Astro.slots.render('footer'))?.trim(),
    heading: (await Astro.slots.render('heading'))?.trim(),
    subheading: (await Astro.slots.render('subheading'))?.trim(),

    tags: (
        await Promise.all(
            Array.from({ length: maxTags }, (_, i) =>
                Astro.slots.render(`tag-${i + 1}`).then((str) => str?.trim()),
            ),
        )
    ).filter((str) => !!str),
};

const ids = getLinkCardIds(id);

const elements = {
    card: {
        ...attrs,
        'class': makeClassList(
            [
                classBase,
                {
                    [`background-${background}`]: !!background,
                },
            ],
            classList,
        ),
        'data-active-theme': activeTheme,
        'data-link-card': href,
        'tag': 'div',
    } satisfies DynamicWrapperProps<'div'>,

    container: {
        'aria-labelledby': html.heading ? ids.heading : null,
        'class': `${classBase}__wrapper`,
        'id': ids.container,
        'tag': 'article',
    } satisfies DynamicWrapperProps<'article'>,

    content:
        html.content &&
        ({
            class: `${classBase}__body`,
        } satisfies HTMLAttributes<'div'>),

    date:
        html.date &&
        ({
            class: `${classBase}__date`,
        } satisfies HTMLAttributes<'div'>),

    description:
        html.description &&
        ({
            class: `${classBase}__description`,
        } satisfies HTMLAttributes<'div'>),

    footer:
        html.footer &&
        ({
            class: `${classBase}__footer`,
        } satisfies HTMLAttributes<'div'>),

    heading:
        html.heading &&
        ({
            attrs: {
                hgroup: {
                    class: `${classBase}__hgroup`,
                },
                subheading: {
                    class: `${classBase}__subheading`,
                },
            },

            class: `${classBase}__heading`,
            displayHeading,
            heading,
            id: ids.heading,
        } satisfies HeadingProps),

    link: {
        'class': `${classBase}__link`,
        'data-link-card-link': id,
        href,
    } satisfies HTMLAttributes<'a'>,

    tags: html.tags.length
        ? {
              class: `${classBase}__tag-list`,
          }
        : '',
} as const;

const elements_linkUnstyled = {
    ...elements.link,

    class: 'unstyled-link',
} as const satisfies HTMLAttributes<'a'>;

const elements_linkIcon = {
    ...elements.link,

    'aria-label': readMoreText,
    'class': `${classBase}__link ${classBase}__link--icon`,
    'title': readMoreText,
} as const satisfies HTMLAttributes<'a'>;

const elements_linkHiddenBackdrop = {
    ...elements_linkUnstyled,

    'aria-hidden': 'true',
    'class': `unstyled-link | ${classBase}__link ${classBase}__link--backdrop`,
    'title': readMoreText,
} as const satisfies HTMLAttributes<'a'>;
---

<Container {...elements.container}>
    {
        elements.description && (
            <div
                {...elements.description}
                set:html={html.description}
            />
        )
    }

    <CardContainer {...elements.card}>
        {
            elements.heading && (
                <Heading {...elements.heading}>
                    <a
                        {...elements.link}
                        set:html={html.heading}
                    />
                    {html.subheading && (
                        <Fragment slot='subheading'>
                            <Fragment set:html={html.subheading} />
                            <a {...elements_linkHiddenBackdrop} />
                        </Fragment>
                    )}
                    <a {...elements_linkHiddenBackdrop} />
                </Heading>
            )
        }
        {
            elements.content && (
                <div {...elements.content}>
                    <Fragment set:html={html.content} />
                    <a {...elements_linkHiddenBackdrop} />
                </div>
            )
        }
        {
            elements.tags && (
                <ul {...elements.tags}>
                    {html.tags.map((_htmlTag) => (
                        <li class={`${classBase}__tag`}>
                            <span
                                class={`${classBase}__tag__text_flag`}
                                set:html={_htmlTag}
                            />
                        </li>
                    ))}
                    <a {...elements_linkHiddenBackdrop} />
                </ul>
            )
        }
        {
            elements.footer && (
                <div {...elements.footer}>
                    <Fragment set:html={html.footer} />
                    <a {...elements_linkHiddenBackdrop} />
                </div>
            )
        }
        {
            elements.date && (
                <div {...elements.date}>
                    <Fragment set:html={html.date} />
                    <a {...elements_linkHiddenBackdrop} />
                </div>
            )
        }
        <a {...elements_linkIcon}
            ><Icon
                aria-hidden='true'
                icon='continue'
                tokens={tokens}
            /></a
        >
    </CardContainer>
</Container>
