---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { PartialExcept } from '@maddimathon/utility-typescript/types';
import type { ElementProps } from '@maddimathon/utility-astro';

import type { ToggleComponentType } from '@maddimathon/utility-astro/components';

import type { RecursiveRecord } from '../../ts/01-utilities/@types.d.ts';
import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';
import type { Tokens_Themes_Set } from '../../ts/02-tokens/Themes/Themes_Set.js';

import type { LoremIpsumComponentType, LoremIpsumProps } from './LoremIpsum.astro';

/* import - functions */
import { objectEntries, objectMap, toTitleCase } from '@maddimathon/utility-typescript';
import { CssColours } from '@maddimathon/utility-sass';

import { ColourUtilities } from '../../ts/01-utilities/ColourUtilities.js';
import { objectGenerator } from '../../ts/01-utilities/objectGenerator.js';
import { getColourCSS } from '../../ts/03-parsers/getColourCSS.js';

/* import - values */

/* import - components */
import {
    Button as ButtonComponent,
    FormField as FormFieldComponent,
    Heading as HeadingComponent,
    Table as TableComponent,
    VariableDump,
} from '@maddimathon/utility-astro/components';

import LoremIpsumComponent from './LoremIpsum.astro';
import ToggleComponent from './Toggle.astro';

import ThemeModeSwatch_ShadesInUse from './ThemeModeSwatch_ShadesInUse.astro';
import ThemeModeSwatch_ThemeSlug from './ThemeModeSwatch_ThemeSlug.astro';

/* import - layouts */

/* PROPS ===================================== */

export type ThemeModeSwatchProps_Components = {
    /**
     * @since 0.1.0-beta.0
     * @since 0.1.0-beta.3 — Moved to a components prop.
     */
    LoremIpsum: LoremIpsumComponentType;

    /**
     * @since 0.1.0-beta.0
     * @since 0.1.0-beta.3 — Moved to a components prop.
     */
    Toggle: ToggleComponentType;
} & PartialExcept<LoremIpsumProps.Components, 'Button'|'Heading'|'FormField'|'Table'>;

export type ThemeModeSwatchProps<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> = ElementProps<{
    heading: number;
    theme: Tokens_Themes_Set.SingleMode.JsonReturn<T_Types['colour'], T_Types['theme']>;
    tokens: Tokens.JsonReturn;

    displayMode: 'preview' | 'tokens';

    brightness?: TokenTypes.Theme.GetBrightnessKeys<T_Types[ 'theme' ]>;
    contrast?: TokenTypes.Theme.GetContrastKeys<T_Types[ 'theme' ]>;

    /**
     * @since 0.1.0-beta.3
     */
    components?: Partial<ThemeModeSwatchProps_Components>;

    displayHeading?: number;
    
    /**
     * HTML string used between the theme token name and its value.
     */
    equals?: string;

    /**
     * @since 0.1.0-beta.3
     */
    levelsInUseTable?: 'prepend'|'append';
}, 'div'>;

type Props = ThemeModeSwatchProps

const {
    components: inputComponents = {},
    theme,
    brightness = theme.brightness ?? undefined,
    contrast = theme.contrast && theme.contrast !== 'forcedColors' ? theme.contrast : undefined,
    displayHeading = 3,
    displayMode,
    equals = '=',
    heading,
    levelsInUseTable = 'append',
    tokens,

    ...attributes
}: Props = Astro.props;

const components = {
    ...inputComponents,

    Button: inputComponents.Button ?? ButtonComponent,
    FormField: inputComponents.FormField ?? FormFieldComponent,
    Heading: inputComponents.Heading ?? HeadingComponent,
    LoremIpsum: inputComponents.LoremIpsum ?? LoremIpsumComponent,
    Table: inputComponents.Table ?? TableComponent,
    Toggle: inputComponents.Toggle ?? ToggleComponent,
} satisfies ThemeModeSwatchProps_Components;

const { Button, FormField, Heading, LoremIpsum } = components;

/* TYPES ===================================== */

type _DefClrParams<
    T_ExtraColourLevels extends ColourUtilities.Levels.Optional = never,
> = {
    names: string;
    extraLevels: T_ExtraColourLevels;
};

type _ButtonVariation = {
    name: string;
    states: {
        [ K in keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams>['background'] ]: {

            [ K in keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams> ]: undefined | {
                state: null | Exclude<
                    keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams>['background'],
                    '$'
                >;
                key: string;
                value: string | string[];
            };
        };
    };
};

type _ParsedInputField_Single = {

    [ State in "$" | "focus" | "hover" | "active" ]: {

        [ K in "accent"|"background"|"border"|"text"|"placeholder" ]: {
            state: null | "focus" | "hover" | "active";
            variation: "$" | "disabled" | "readonly",
            label: string;
            key: string;
            clrSlug: null | string | string[];
        };
    };
};

type _ParsedInputField = {
    $: _ParsedInputField_Single;
    disabled: Pick<_ParsedInputField_Single, '$'>;
    readonly: Pick<_ParsedInputField_Single, '$'>;
};

/* FUNCTIONS ===================================== */

export function getCssColourForThemePreview<T_Types extends TokenTypes.TypeParams>(
    tokens: Tokens.JsonReturn<T_Types>,
    brightness: undefined | TokenTypes.Theme.GetBrightnessKeys<T_Types[ 'theme' ]>,
    clrSlug: string | string[],
    convertToVarFn: boolean = true,
) {
    if ( Array.isArray( clrSlug ) ) {
        clrSlug = clrSlug[0] ?? String( clrSlug );
    }
    
    if ( CssColours.isKeyword( clrSlug ) ) {
        return 'inherit' as const;
    }

    if ( CssColours.isSystemColor( clrSlug ) ) {
        return clrSlug;
    }

    return getColourCSS( tokens, brightness, clrSlug, convertToVarFn );
}

function themeTokenFlatten<T_Val extends string | number | undefined | null | any[]>( 
    prefix: null|string,
    obj:  RecursiveRecord<string, T_Val>,
): { key: string; value: T_Val; }[] {
    const pre = prefix == '$' ? '' : prefix ?? '';

    return Object.values(
        objectMap(
            obj,
            ( [ key, value ] ) => {
                key = pre + ( key == '$' ? '' : `-${key}` );

                // returns 
                if ( value && typeof value === 'object' && !Array.isArray(value) ) {
                    return themeTokenFlatten( key, value );
                }
                
                return [{key: 'theme-' + key, value}];
            }
        )
    ).flat();
}

/* CONSTANTS ===================================== */

const customDisplayKeys = [ 'background', 'button', 'input', 'selection', 'system' ];

const autoTokens = Object.values(
    objectMap(
        theme.data,
        ([ key, value ]) => customDisplayKeys.includes(key)
            ? false
            : (typeof value !== 'object' || Array.isArray( value ) )
              ? { key, value }
              : { key, variations: themeTokenFlatten<string|string[]>( key, value ) }
    )
).filter((v) => v !== false);

const headingHTML = Astro.slots.has('heading') && (await Astro.slots.render('heading'))?.trim();


const buttons: {
    [ K in 'primary' | 'secondary' | 'disabled' ]: _ButtonVariation;
} & {
    [ key: string ]: _ButtonVariation;
} = objectMap(
    theme.data.button,
    ( [ variation, value ] ): _ButtonVariation => ( {
        name: variation,
        states: objectGenerator(
            [ '$', 'hover', 'active' ],
            ( key ) => {

                const state =  key == '$' ? null : key;

                const keySuffix = key == '$' ? '' : `-${key}`;
                
                return {
                    background: {
                        state,
                        key: `button-${variation}-background${keySuffix}`,
                        value: typeof value.background === 'object' ? value.background[key] : value.background,
                    },
                    border: {
                        state,
                        key: `button-${variation}-border${keySuffix}`,
                        value: typeof value.border === 'object' ? value.border[key] : value.border,
                    },
                    outline: state && value.outline[key] ? {
                        state,
                        key: `button-${variation}-outline${keySuffix}`,
                        value: typeof value.outline === 'object' ? value.outline[key] : value.outline,
                    } : undefined,
                    text: {
                        state,
                        key: `button-${variation}-text${keySuffix}`,
                        value: typeof value.text === 'object' ? value.text[key] : value.text,
                    },
                    ui: {
                        state,
                        key: `button-${variation}-ui${keySuffix}`,
                        value: typeof value.text === 'object' ? value.text[key] : value.text,
                    },
                };
            }
        ),
    } ),
);

function _inputFieldGenerator<T_InputType extends '$', T_State extends '$'|'active'|'focus' |'hover'>(inputType: T_InputType, state: T_State): _ParsedInputField[T_InputType][T_State];

function _inputFieldGenerator<T_InputType extends 'disabled'|'readonly', T_State extends '$'>(inputType: T_InputType, state: T_State): _ParsedInputField[T_InputType][T_State];

function _inputFieldGenerator<T_InputType extends '$'|'disabled'|'readonly', T_State extends '$'|'active'|'focus' |'hover'>(inputType: T_InputType, key: T_State) {
    const state =  key === '$' ? null : key as Exclude<T_State, '$'>;

    const keySuffix = key == '$' ? '' : `-${key}`;

    const keyInputSuffix = inputType == '$' ? '' : `-${key}`;

    const label = `Input Field${inputType !== '$' ? ` (${toTitleCase(inputType)})`: ''}${ state ? ` — ${state}` : '' }`;

    const themeValues = inputType === '$'
        ? ['full', theme.data.input[inputType as '$']] as const
        : ['short', theme.data.input[inputType as Exclude<T_InputType, '$'>]] as const;

    return {
        accent: {
            key: `input${keyInputSuffix}-accent${keySuffix}`,
            state,
            label,
            variation: inputType,
            clrSlug: themeValues[0] === 'full' ? themeValues[1].accent[key] : themeValues[1].accent,
        },
        background: {
            key: `input${keyInputSuffix}-background${keySuffix}`,
            state,
            label,
            variation: inputType,
            clrSlug: themeValues[1].background,
        },
        border: {
            key: `input${keyInputSuffix}-border${keySuffix}`,
            state,
            label,
            variation: inputType,
            clrSlug: themeValues[0] === 'full' ? themeValues[1].border[key] : themeValues[1].border,
        },
        text: {
            key: `input${keyInputSuffix}-color${keySuffix}`,
            state,
            label,
            variation: inputType,
            clrSlug: themeValues[1].text,
        },
        placeholder: {
            key: `input${keyInputSuffix}-placeholder${keySuffix}`,
            state,
            label,
            variation: inputType,
            clrSlug: themeValues[1].placeholder,
        },
    } satisfies _ParsedInputField_Single['$'];
}

const inputField = {
    $: {
        $: _inputFieldGenerator( '$', '$' ),
        hover: _inputFieldGenerator( '$', 'hover' ),
        focus: _inputFieldGenerator( '$', 'focus' ),
        active: _inputFieldGenerator( '$', 'active' ),
    },
    disabled: {
        $:_inputFieldGenerator( 'disabled', '$' ),
    },
    readonly: {
        $:_inputFieldGenerator( 'readonly', '$' ),
    },
} as const satisfies _ParsedInputField;
---

<article
    {...attributes}
    class='container theme-mode-swatch'
>
    {
        headingHTML && (
            <Heading
                heading={heading - 1}
                displayHeading={displayHeading - 1}
                class:list={ [
                    'theme-mode-swatch__name',
                ] }
                set:html={headingHTML}
            />
        )
    }

    { theme.description &&  (
        <p class="theme-mode-swatch__description" set:html={theme.description} />
        <hr />
    ) }
    
    { displayMode == 'tokens' ? <Fragment>
        { levelsInUseTable === 'prepend' && (
            <ThemeModeSwatch_ShadesInUse {...{ components, displayHeading, heading, theme, tokens }} />
            <hr />
        ) }
        <Heading
            heading={heading}
            displayHeading={displayHeading}
            set:text='Tokens'
        />
        {Object.entries(theme.data.background).map(([_bgSlug, _bgValue]) => (
            <p
                class="theme-mode-swatch__sample"
                style={ [
                    `--background: ${getCssColourForThemePreview(tokens, brightness, _bgValue)} !important`,
                    `color: ${getCssColourForThemePreview(tokens, brightness, theme.data.text.$)} !important`,
                ].join(';') }
            ><samp set:text={ _bgSlug === '$' ? 'theme-background': `theme-background-${_bgSlug}` } /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: _bgValue}} /></p>
        ))}
        <p
            class="theme-mode-swatch__sample theme-mode-swatch__sample--selection"
        ><samp set:text='theme-selection-background' /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: theme.data.selection.background}} /></p>
        <p
            class="theme-mode-swatch__sample theme-mode-swatch__sample--selection"
        ><samp set:text='theme-selection-text' /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: theme.data.selection.text}} /></p>
        {
            autoTokens.map((_tokens) => (
                <Heading
                    heading={heading + 1}
                    displayHeading={displayHeading + 1}
                    set:text={`${_tokens.key == 'ui' ? _tokens.key.toUpperCase() : toTitleCase(_tokens.key)} Tokens`}
                />
                <Fragment>{ _tokens.variations ? _tokens.variations.map( ( { key, value } ) => (
                    <p
                        class="theme-mode-swatch__sample"
                        style={ `color: ${getCssColourForThemePreview(tokens, brightness, value)} !important` }
                    ><samp set:text={key} /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: value}} /></p>
                ) ) : (
                    <VariableDump
                        components={components}
                        name='_tokens'
                        var={_tokens}
                    />
                ) }</Fragment>  
            ))
        }
        <Heading
            displayHeading={displayHeading + 1}
            heading={heading + 1}
            set:text='Buttons'
        />
        { import.meta.env.DEV && ( 
            <Fragment>
                <Heading
                    heading={heading + 2}
                    class:list='screen-reader-text'
                    set:text='Button Previews'
                />
                { [
                    ...Object.values( buttons ).filter( variation => variation.name !== 'disabled' ),
                    buttons.disabled,
                ].map( ( variation ) => (
                    <section
                        aria-label={variation.name + ' button previews'}
                        class:list={['button-span | theme-mode-swatch__button-span']}
                    >{ Object.values( variation.states ).map( ( state ) => (
                        <Button
                            aria-disabled={ variation.name === 'disabled' ? true : undefined }
                            class:list={ [
                                'theme-mode-swatch__sample',
                                'theme-mode-swatch__sample--button',
                            ] }
                            style={ [
                                state.border?.value && `border-color: ${getCssColourForThemePreview(tokens, brightness, state.border.value)} !important`,
                                state.background?.value && `--background: ${getCssColourForThemePreview(tokens, brightness, state.background.value)} !important`,
                                state.text?.value && `color: ${getCssColourForThemePreview(tokens, brightness, state.text.value)} !important`,
                            ].filter( v => v ).join(';') }
                            type='button'
                            variant={ variation.name !== 'disabled' ? variation.name : undefined }
                        >{`${toTitleCase(variation.name)} Button${state.background?.state ? ` (${state.background.state})` : ''}`}</Button>
                    ) ) }</section>
                ) ) }
            </Fragment>
         ) }

        <Heading
            heading={heading + 2}
            class:list='screen-reader-text'
            set:text='Button Token Values'
        />
        { Object.values( buttons ).map( ( variation ) => variation.name !== 'disabled' && (
            <Heading
                heading={heading + 3}
                displayHeading={displayHeading + 2}
                set:text={`${toTitleCase(variation.name)} Button`}
            />
            <Fragment>{ Object.values( variation.states ).map(
                ( state ) => (['background', 'border', 'text', 'ui'] as const).map(
                    (key) => (
                        state[key] && ( key != 'border' || state.border?.value != state.background?.value ) && <p
                            class="theme-mode-swatch__sample"
                            style={ [
                                key === 'background' && state.text
                                    ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.text.value)} !important`
                                    : (key == 'text' || key == 'ui') && state.background
                                        ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.background.value)} !important`
                                        : '',
                                `color: ${getCssColourForThemePreview(tokens, brightness, state[key].value)} !important`,
                            ].filter( v => v ).join(';') }
                        ><samp set:text={`theme-button-${variation.name}-${key}${state[key].state ? `-${state[key].state}`: '' }`} /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: state[key].value}} /></p>
                    )
                )
            ) }</Fragment>
        ) ) }
        <Heading
            heading={heading + 3}
            displayHeading={displayHeading + 2}
            set:text={`${toTitleCase(buttons.disabled.name)} Button`}
        />
        { Object.values( buttons.disabled.states ).map(
            ( state ) => objectEntries(state).map(
                ([key]) => state[key] && ( 
                    key != 'border' || state.border?.value != state.background?.value 
                ) && (
                    <p
                        class="theme-mode-swatch__sample"
                        style={ [
                            key === 'background' && state.text
                                ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.text.value)} !important`
                                : (key == 'text' || key == 'ui') && state.background
                                    ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.background.value)} !important`
                                    : '',
                            `color: ${getCssColourForThemePreview(tokens, brightness, state[key].value)} !important`,
                        ].filter( v => v ).join(';') }
                    ><samp set:text={`theme-button-${buttons.disabled.name}-${key}${state[key].state ? `-${state[key].state}`: '' }`} /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: state[key].value}} /></p>
                )
            )
        ) }

        <Heading
            heading={heading + 1}
            displayHeading={displayHeading + 1}
            set:text='Input Fields'
        />
        { Object.entries( inputField ).map( ( [variation, fieldSet] ) => Object.values(fieldSet).map( ( state ) => (
            <FormField
                aria-disabled={ variation === 'disabled' ? 'true' : undefined }
                class:list={ [
                    'theme-mode-swatch__sample',
                    'theme-mode-swatch__sample--input',
                ] }
                components={components}
                disabled={ variation === 'disabled' ? 'true' : undefined }
                id={`theme-mode-swatch__sample__${variation}__${state.background.state ?? 'base'}`}
                labelAttrs={{ class: "screen-reader-text" }}
                placeholder={ variation === '$' ? state.background.label : '' }
                readonly={ variation === 'readonly' ? 'true' : undefined }
                style={ [
                    state.border.clrSlug && `border-color: ${getCssColourForThemePreview(tokens, brightness, state.border.clrSlug)} !important`,
                    state.background.clrSlug && `--background: ${getCssColourForThemePreview(tokens, brightness, state.background.clrSlug)} !important`,
                    state.text.clrSlug && `color: ${getCssColourForThemePreview(tokens, brightness, state.text.clrSlug)} !important`,
                ].filter( v => v ).join(';') }
                type="text"
                value={ variation === '$' ? undefined : state.background.label }
            ><Fragment slot='label'>{state.background.label}</Fragment></FormField>
        ) ) ) }
        <Heading
            heading={heading + 2}
            class:list='screen-reader-text'
            set:text='Input Fields Token Values'
        />
        { Object.entries( inputField ).map( ( [variation, fieldSet] ) => (
            <Heading
                heading={heading + 3}
                displayHeading={displayHeading + 2}
                set:text={`${ variation !== '$' ? `${toTitleCase(variation)} ` : '' }Input Fields`}
            />
            <Fragment>{ Object.values( fieldSet ).map(
                ( state ) => (['accent', 'background', 'border', 'text'] as const).map(
                    (key) => (
                        state[key] && <p
                            class="theme-mode-swatch__sample"
                            style={ [
                                ( key == 'text') && state.background?.clrSlug 
                                    ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.background.clrSlug)} !important`
                                    : '',
                                (key == 'background') && state.text?.clrSlug 
                                    ? `--background: ${getCssColourForThemePreview(tokens, brightness, state.text.clrSlug)} !important`
                                    : '',
                                state[key].clrSlug && `color: ${getCssColourForThemePreview(tokens, brightness, state[key].clrSlug)} !important`,
                            ].filter( v => v ).join(';') }
                        ><samp set:text={`theme-input${ variation !== '$' ? `-${variation}` : '' }-${key}${state[key].state ? `-${state[key].state}`: '' }`} /> {equals} <ThemeModeSwatch_ThemeSlug {...{brightness,  clrSlug: state[key].clrSlug}} /></p>
                    )
                )
             ) }</Fragment>
        ) ) }
        <slot name="tokens" />
        { levelsInUseTable === 'append' && (
            <hr />
            <ThemeModeSwatch_ShadesInUse {...{ components, displayHeading, heading, theme, tokens }} />
        ) }
    </Fragment> : (
        <LoremIpsum
            abbreviated={true}
            components={components}
            displayHeading={displayHeading}
            displaySettings={ {
                blockquote: import.meta.env.DEV,
                buttonTypes: import.meta.env.DEV,
                buttonVariationsAll: true,
                code: import.meta.env.DEV,
                disabledButton: import.meta.env.DEV,
                forms: false, 
                listsLong: import.meta.env.DEV,
                listsMedium: true,
                textMedium: false,
                textPage: false,
                toc: false,
            } }
            heading={heading}
            mode={import.meta.env.DEV ? 'fancy': 'library'}
            tokens={tokens}
        >
            { Object.entries( inputField ).map( ( [variation, fieldSet] ) => (
                <FormField
                    aria-disabled={ variation === 'disabled' ? 'true' : undefined }
                    class:list={ [
                        'theme-mode-swatch__sample',
                        'theme-mode-swatch__sample--input',
                    ] }
                    components={components}
                    disabled={ variation === 'disabled' ? 'true' : undefined }
                    id={`theme-mode-swatch__sample__${variation}__preview`}
                    labelAttrs={{ class: "screen-reader-text" }}
                    placeholder={ variation === '$' ? 'This is a placeholder value.' : '' }
                    readonly={ variation === 'readonly' ? 'true' : undefined }
                    slot="four"
                    style={ [
                      fieldSet.$.border.clrSlug && `border-color: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.border.clrSlug)} !important`,
                      fieldSet.$.background.clrSlug && `--background: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.background.clrSlug)} !important`,
                      fieldSet.$.text.clrSlug && `color: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.text.clrSlug)} !important`,
                    ].filter( v => v ).join(';') }
                    type="text"
                    value={ variation === '$' ? undefined : `This is a ${variation} input.` }
                ><Fragment slot='label'>{fieldSet.$.background.label}</Fragment></FormField>
            ) ) }
        </LoremIpsum>
        <slot name="preview" />
    ) }
</article>

<style lang='scss'>
    @forward '../scss/theme-mode-swatch';
</style>
