---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type { RecursiveRecord } from '../../ts/01-utilities/@types.d.ts';
import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';
import type { Tokens_Colour_ShadeMap } from '../../ts/02-tokens/Colour/Colour_ShadeMap.js';
import type { Tokens_Themes_Set } from '../../ts/02-tokens/Themes/Themes_Set.js';

/* import - functions */
import { 
    objectMap,
    toTitleCase,
} from '@maddimathon/utility-typescript';
import { CssColours } from '@maddimathon/utility-sass';
import { ColourUtilities } from '../../ts/01-utilities/ColourUtilities.js';
import { objectGenerator } from '../../ts/01-utilities/objectGenerator.js';
import { getColourValue } from '../functions/getColourValue.js';
import { getColourCSS } from '../../ts/03-parsers/getColourCSS.js';
import { textColorLevel } from '../functions/textColorLevel.js';

/* import - values */

/* import - components */
import Heading from '@maddimathon/utility-astro/components/Heading';
import Table from '@maddimathon/utility-astro/components/Table';
import VariableDump from '@maddimathon/utility-astro/components/VariableDump';
import LoremIpsum from './LoremIpsum.astro';

/* import - layouts */

/* PROPS ===================================== */

export interface Props<
    T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams,
> extends Omit<HTMLAttributes<'div'>, 'class'> {
    heading: number;
    theme: Tokens_Themes_Set.SingleMode.JsonReturn<T_Types['colour'], T_Types['theme']>;
    tokens: Tokens.JsonReturn;

    displayMode: 'preview' | 'tokens';

    brightness?: TokenTypes.Theme.GetBrightnessKeys<T_Types[ 'theme' ]>;
    contrast?: TokenTypes.Theme.GetContrastKeys<T_Types[ 'theme' ]>;

    displayHeading?: number;
    
    /**
     * HTML string used between the theme token name and its value.
     */
    equals?: string;
}

const {
    brightness,
    contrast,
    displayHeading = 3,
    displayMode,
    equals = '=',
    heading,
    theme,
    tokens,
    ...attributes
}: Props = Astro.props;

/* TYPES ===================================== */

type _DefClrParams<
    T_ExtraColourLevels extends ColourUtilities.Levels.Optional = never,
> = {
    names: string;
    extraLevels: T_ExtraColourLevels;
};

// type SingleThemeMode_Json<
//     T_ExtraColourLevels extends ColourUtilities.Levels.Optional = ColourUtilities.Levels.Optional,
// > = Tokens_Themes_Set.SingleMode.JsonReturn<_DefClrParams<T_ExtraColourLevels>, TokenTypes.Theme.TypeParams>;

type _ButtonVariation = {
    name: string;
    states: {
        [ K in keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams>['background'] ]: {

            [ K in keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams> ]: undefined | {
                state: null | Exclude<
                    keyof Tokens_Themes_Set.SingleMode.Data.Button<_DefClrParams>['background'],
                    '$'
                >;
                key: string;
                value: string | string[] ;
            };
        };
    };
};

type _ParsedInputField_Single = {

    [ State in "$" | "hover" | "active" ]: {

        [ K in "accent"|"background"|"border"|"text"|"placeholder" ]: {
            state: null | "$" | "hover" | "active";
            variation: "$" | "disabled" | "readonly",
            label: string;
            key: string;
            clrSlug: null | string | string[];
        };
    };
};

type _ParsedInputField = {
    [ InputType in "$"|"disabled"|"readonly" ]: _ParsedInputField_Single;
};

/* FUNCTIONS ===================================== */

export function getCssColourForThemePreview<
    T_Types extends TokenTypes.TypeParams,
>(
    tokens: Tokens.JsonReturn<T_Types>,
    brightness?: TokenTypes.Theme.GetBrightnessKeys<T_Types[ 'theme' ]>,
    clrSlug: string | string[],
    convertToVarFn: boolean = true,
) {
    if ( Array.isArray( clrSlug ) ) {
        clrSlug = clrSlug[0] ?? String( clrSlug );
    }
    
    if ( CssColours.isKeyword( clrSlug ) ) {
        return 'inherit' as const;
    }

    if ( CssColours.isSystemColor( clrSlug ) ) {
        return clrSlug;
    }

    return getColourCSS( tokens, brightness, clrSlug, convertToVarFn );
}

function themeTokenFlatten<T_Val extends string | number |undefined |null|any[]>( 
    prefix: null|string,
    obj:  RecursiveRecord<string, T_Val>,
): { key: string; value: T_Val; }[] {
    const pre = prefix == '$' ? '' : prefix ?? '';

    const mapper = ( [ key, value ]: [
        string,
        T_Val|RecursiveRecord<string, T_Val>
    ] ): {
        key: string;
        value: T_Val;
    }[] => {
        key = pre + ( key == '$' ? '' : `-${key}` );

        // returns 
        if ( value && typeof value === 'object' && !Array.isArray(value) ) {
            return themeTokenFlatten( key, value );
        }
        
        return [{key: 'theme-' + key, value}];
    };

    return Object.values(
        objectMap(
            obj,
            mapper
        )
    ).flat();
}

/* CONSTANTS ===================================== */

const customDisplayKeys = [ 'background', 'button', 'input', 'selection', 'system' ];

const autoTokens = Object.values(
    objectMap(theme.data, ([key, value ]) =>
        customDisplayKeys.includes(key)
            ? false
            : (typeof value !== 'object' || Array.isArray( value ) )
              ? { key, value }
              : { key, variations: themeTokenFlatten( 
                    key, 
                    value as RecursiveRecord<string, string>
                ) }
    )
).filter((v) => v !== false);

const headingHTML = (await Astro.slots.render('heading')) || false;


const levelsInUseTable = theme.levelsInUse.map(
    ( levels ) => ( {
        levels,

        styles: objectMap(
            levels,
            ( [ key, value ] ) => {
                key;

                const textColor = textColorLevel( value );

                let background: Tokens_Colour_ShadeMap.Shade.JsonReturn<_DefClrParams<ColourUtilities.Levels.Optional>>;
                let color: Tokens_Colour_ShadeMap.Shade.JsonReturn<_DefClrParams<ColourUtilities.Levels.Optional>>;

                switch ( value ) {

                    case 'black':
                    case 'white':
                        background = tokens.colour.$[value];
                        break;
                    
                    default:
                        background = tokens.colour.base[value];
                        break;
                }

                switch ( textColor ) {

                    case 'black':
                    case 'white':
                        color = tokens.colour.$[textColor];
                        break;
                    
                    default:
                        color = tokens.colour.base[textColor];
                        break;
                }
                
                return { background, color };
            }
        ),
    } ),
);


const buttons: {
    [ K in 'primary' | 'secondary' | 'disabled' ]: _ButtonVariation;
} & {
    [ key: string ]: _ButtonVariation;
} = objectMap(
    theme.data.button,
    ( [ variation, value ] ): _ButtonVariation => ( {
        name: variation,
        states: objectGenerator(
            [ '$', 'hover', 'active' ],
            ( key ) => {

                const state =  key == '$' ? null : key;

                const keySuffix = key == '$' ? '' : `-${key}`;
                
                return {
                    background: {
                        state,
                        key: `button-${variation}-background${keySuffix}`,
                        value: value.background[key],
                    },
                    border: {
                        state,
                        key: `button-${variation}-border${keySuffix}`,
                        value: value.border[key],
                    },
                    outline: state && value.outline[key] ? {
                        state,
                        key: `button-${variation}-outline${keySuffix}`,
                        value: value.outline[key],
                    } : undefined,
                    text: {
                        state,
                        key: `button-${variation}-text${keySuffix}`,
                        value: value.text[key],
                    },
                    ui: {
                        state,
                        key: `button-${variation}-ui${keySuffix}`,
                        value: value.text[key],
                    },
                };
            }
        ),
    } ),
);

const inputField: _ParsedInputField = objectGenerator(
    [ '$', 'disabled','readonly' ] as const,
    ( inputType ) => objectGenerator(
        [ '$', 'hover', 'active' ] as const,
        ( key ): _ParsedInputField_Single['$'|'active'|'hover'] => {
            const state =  key == '$' ? null : key;

            const keySuffix = key == '$' ? '' : `-${key}`;

            const keyInputSuffix = inputType == '$' ? '' : `-${key}`;

            const label = `Input Field${inputType !== '$' ? ` (${toTitleCase(inputType)})`: ''}${ state ? ` — ${state}` : '' }`;
            
            return {
                accent: {
                    key: `input${keyInputSuffix}-accent${keySuffix}`,
                    state,
                    label,
                    variation: inputType,
                    clrSlug: theme.data.input[inputType].accent[key],
                    // clrSlug: getThemeTokenColourSlug(
                    //     tokens.css.style.input[inputType].accent[key],
                    //     theme.name,
                    //     brightness,
                    //     contrast,
                    //     tokens,
                    // ),
                },
                background: {
                    key: `input${keyInputSuffix}-background${keySuffix}`,
                    state,
                    label,
                    variation: inputType,
                    clrSlug: theme.data.input[inputType].background,
                    // clrSlug: getThemeTokenColourSlug(
                    //     tokens.css.style.input[inputType].background,
                    //     theme.name,
                    //     brightness,
                    //     contrast,
                    //     tokens,
                    // ),
                },
                border: {
                    key: `input${keyInputSuffix}-border${keySuffix}`,
                    state,
                    label,
                    variation: inputType,
                    clrSlug: theme.data.input[inputType].border[key],
                    // clrSlug: getThemeTokenColourSlug(
                    //     tokens.css.style.input[inputType].border.color[key],
                    //     theme.name,
                    //     brightness,
                    //     contrast,
                    //     tokens,
                    // ),
                },
                text: {
                    key: `input${keyInputSuffix}-color${keySuffix}`,
                    state,
                    label,
                    variation: inputType,
                    clrSlug: theme.data.input[inputType].text,
                    // clrSlug: getThemeTokenColourSlug(
                    //     tokens.css.style.input[inputType].color,
                    //     theme.name,
                    //     brightness,
                    //     contrast,
                    //     tokens,
                    // ),
                },
                placeholder: {
                    key: `input${keyInputSuffix}-placeholder${keySuffix}`,
                    state,
                    label,
                    variation: inputType,
                    clrSlug: theme.data.input[inputType].placeholder,
                    // clrSlug: getThemeTokenColourSlug(
                    //     tokens.css.style.input.$.placeholder.color,
                    //     theme.name,
                    //     brightness,
                    //     contrast,
                    //     tokens,
                    // ),
                },
            } satisfies _ParsedInputField_Single['$'|'active'|'hover'];
        }
    ) as _ParsedInputField_Single
);
---

<article
    class:list={['container', 'theme-mode-swatch']}
    {...attributes}
    data-brightness-mode={brightness}
    data-contrast-mode={contrast}
    style={ [
        `--theme-background: var(--clr-${theme.data.background.$})`,
        `--theme-text: var(--clr-${theme.data.text.$})`,
        `background: var(--clr-${theme.data.background.$})`,
        `color: var(--clr-${theme.data.text.$})`,
    ].join(';') }
>
    {
        headingHTML && (
            <Heading
                heading={heading - 1}
                displayHeading={displayHeading - 1}
                class:list={ [
                    'theme-mode-swatch__name',
                ] }
                set:html={headingHTML}
            />
        )
    }

    { theme.description &&  <p class="theme-mode-swatch__description" set:html={theme.description} /> }
    
    { displayMode == 'tokens' ? <Fragment>
        <Heading
            heading={heading}
            displayHeading={displayHeading}
            set:text='Tokens'
        />
        {Object.entries(theme.data.background).map(([_bgSlug, _bgValue]) => (
            <p
                class="theme-mode-swatch__sample"
                style={ [
                    `background: ${getCssColourForThemePreview(tokens, brightness, _bgValue)}`,
                    `color: ${getCssColourForThemePreview(tokens, brightness, theme.data.text.$)}`,
                ].join(';') }
            ><code set:text={ _bgSlug === '$' ? 'theme-background': `theme-background-${_bgSlug}` } /> {equals} <code set:text={_bgValue} /></p>
        ))}
        <p
            class="theme-mode-swatch__sample theme-mode-swatch__sample--selection"
        ><code set:text='theme-selection-background' /> {equals} <code set:text={theme.data.selection.background} /></p>
        <p
            class="theme-mode-swatch__sample theme-mode-swatch__sample--selection"
        ><code set:text='theme-selection-text' /> {equals} <code set:text={theme.data.selection.text} /></p>
        {
            autoTokens.map((_tokens) => (
                <Heading
                    heading={heading + 1}
                    displayHeading={displayHeading + 1}
                    set:text={`${_tokens.key == 'ui' ? _tokens.key.toUpperCase() : toTitleCase(_tokens.key)} Tokens`}
                />
                <Fragment>{ _tokens.variations ? _tokens.variations.map( ( { key, value } ) => (
                    <p
                        class="theme-mode-swatch__sample"
                        style={ `color: ${getCssColourForThemePreview(tokens, brightness, value)}` }
                    ><code set:text={key} /> {equals} <code set:text={value} /></p>
                ) ) : (
                    <VariableDump
                        name='_tokens'
                        var={_tokens}
                    />
                ) }</Fragment>  
            ))
        }
        <Heading
            displayHeading={displayHeading + 1}
            heading={heading + 1}
            set:text='Buttons'
        />
        { import.meta.env.DEV && ( 
            <Fragment>
                <Heading
                    heading={heading + 2}
                    class:list='screen-reader-text'
                    set:text='Button Previews'
                />
                { Object.values( buttons ).map( ( variation ) => (
                    <Heading
                        heading={heading + 3}
                        class:list='screen-reader-text'
                        set:text={variation.name}
                    />
                    <div class:list={['button-span | theme-mode-swatch__button-span']}>{ Object.values( variation.states ).map( ( state ) => (
                        <button
                            set:text={`${toTitleCase(variation.name)} Button${state.background?.state ? ` (${state.background.state})` : ''}`}
                            aria-disabled={ variation.name === 'disabled' ? true : undefined }
                            class:list={ [
                                `button-${variation.name}`,
                                '|',
                                'theme-mode-swatch__sample',
                                'theme-mode-swatch__sample--button',
                            ] }
                            style={ [
                                state.border?.value && `border-color: ${getCssColourForThemePreview(tokens, brightness, state.border.value)}`,
                                state.background?.value && `background: ${getCssColourForThemePreview(tokens, brightness, state.background.value)}`,
                                state.text?.value && `color: ${getCssColourForThemePreview(tokens, brightness, state.text.value)}`,
                            ].filter( v => v ).join(';') }
                        />
                    ) ) }</div>
                ) ) }
            </Fragment>
         ) }
        <Heading
            heading={heading + 2}
            class:list='screen-reader-text'
            set:text='Button Token Values'
        />
        { Object.values( buttons ).map( ( variation ) => (
            <Heading
                heading={heading + 3}
                displayHeading={displayHeading + 2}
                set:text={`${toTitleCase(variation.name)} Button`}
            />
            <Fragment>{ Object.values( variation.states ).map(
                ( state ) => (['background', 'border', 'text', 'ui'] as const).map(
                    (key) => (
                        state[key] && ( key != 'border' || state.border?.value != state.background?.value ) && <p
                            class="theme-mode-swatch__sample"
                            style={ [
                                key === 'background' && state.text
                                    ? `background: ${getCssColourForThemePreview(tokens, brightness, state.text.value)}`
                                    : (key == 'text' || key == 'ui') && state.background
                                        ? `background: ${getCssColourForThemePreview(tokens, brightness, state.background.value)}`
                                        : '',
                                `color: ${getCssColourForThemePreview(tokens, brightness, state[key].value)}`,
                            ].filter( v => v ).join(';') }
                        ><code set:text={`theme-button-${variation.name}-${key}${state[key].state ? `-${state[key].state}`: '' }`} /> {equals} <code set:text={state[key].value} /></p>
                    )
                )
             ) }</Fragment>
        ) ) }
        <Heading
            heading={heading + 1}
            displayHeading={displayHeading + 1}
            set:text='Input Fields'
        />
        { Object.entries( inputField ).map( ( [variation, fieldSet] ) => Object.values(fieldSet).map( ( state ) => (
            <label 
                class="screen-reader-text"
                set:text={state.background.label}
            />
            <input
                aria-disabled={ variation === 'disabled' ? 'true' : undefined }
                class:list={ [
                    'theme-mode-swatch__sample',
                    'theme-mode-swatch__sample--input',
                ] }
                disabled={ variation === 'disabled' ? 'true' : undefined }
                placeholder={ variation === '$' ? state.background.label : '' }
                readonly={ variation === 'readonly' ? 'true' : undefined }
                style={ [
                    state.border.clrSlug && `border-color: ${getCssColourForThemePreview(tokens, brightness, state.border.clrSlug)}`,
                    state.background.clrSlug && `background: ${getCssColourForThemePreview(tokens, brightness, state.background.clrSlug)}`,
                    state.text.clrSlug && `color: ${getCssColourForThemePreview(tokens, brightness, state.text.clrSlug)}`,
                ].filter( v => v ).join(';') }
                type="text"
                value ={ variation === '$' ? undefined : state.background.label }
            /> 
        ) ) ) }
        <Heading
            heading={heading + 2}
            class:list='screen-reader-text'
            set:text='Input Fields Token Values'
        />
        { Object.entries( inputField ).map( ( [variation, fieldSet] ) => (
            <Heading
                heading={heading + 3}
                displayHeading={displayHeading + 2}
                set:text={`${ variation !== '$' ? `${toTitleCase(variation)} ` : '' }Input Fields`}
            />
            <Fragment>{ Object.values( fieldSet ).map(
                ( state ) => (['accent', 'background', 'border', 'text'] as const).map(
                    (key) => (
                        state[key] && <p
                            class="theme-mode-swatch__sample"
                            style={ [
                                ( key == 'text') && state.background?.clrSlug 
                                    ? `background: ${getCssColourForThemePreview(tokens, brightness, state.background.clrSlug)}`
                                    : '',
                                (key == 'background') && state.text?.clrSlug 
                                    ? `background: ${getCssColourForThemePreview(tokens, brightness, state.text.clrSlug)}`
                                    : '',
                                state[key].clrSlug && `color: ${getCssColourForThemePreview(tokens, brightness, state[key].clrSlug)}`,
                            ].filter( v => v ).join(';') }
                        ><code set:text={`theme-input${ variation !== '$' ? `-${variation}` : '' }-${key}${state[key].state ? `-${state[key].state}`: '' }`} /> {equals} <code set:text={state[key].clrSlug} /></p>
                    )
                )
             ) }</Fragment>
        ) ) }
        <slot name="tokens" />
        { levelsInUseTable.length && ( 
            <Heading
                heading={heading}
                displayHeading={displayHeading }
                set:text='Shades in Use'
            />
            <Table 
                class:list={['theme-mode-swatch__shades-in-use']}
            >
                <tr>
                    <th set:text='Light Mode' />
                    <th set:text='Dark Mode' />
                </tr>
                { levelsInUseTable.map( ({ levels, styles }) => <tr>
                    <td 
                        data-brightness-mode="light"
                        set:text={levels.light}
                        style={styles && [
                            `background: ${getColourValue( styles.light.background ) ?? 'unset'}`,
                            `color: ${getColourValue( styles.light.color ) ?? 'unset'}`,
                        ].join(';')}
                    />
                    <td 
                        data-brightness-mode="light"
                        set:text={levels.dark}
                        style={styles && [
                            `background: ${getColourValue( styles.dark.background ) ?? 'unset'}`,
                            `color: ${getColourValue( styles.dark.color ) ?? 'unset'}`,
                        ].join(';')}
                    />
                </tr> ) }
            </Table>
        ) }
    </Fragment> : (
        <hr />
        <LoremIpsum
            abbreviated={true}
            displayHeading={displayHeading}
            displaySettings={ {
                blockquote: import.meta.env.DEV,
                buttonTypes: import.meta.env.DEV,
                buttonVariationsAll: true,
                code: import.meta.env.DEV,
                disabledButton: import.meta.env.DEV,
                forms: false, 
                listsLong: import.meta.env.DEV,
                listsMedium: true,
                textMedium: false,
                textPage: false,
            } }
            heading={heading}
            mode={import.meta.env.DEV ? 'fancy': 'library'}
            tokens={tokens}
        >
            { Object.entries( inputField ).map( ( [variation, fieldSet] ) => (
                <label set:text={fieldSet.$.background.label} />
                <input
                    aria-disabled={ variation === 'disabled' ? 'true' : undefined }
                    class:list={ [
                        'theme-mode-swatch__sample',
                        'theme-mode-swatch__sample--input',
                    ] }
                    disabled={ variation === 'disabled' ? 'true' : undefined }
                    placeholder={ variation === '$' ? 'This is a placeholder value.' : '' }
                    readonly={ variation === 'readonly' ? 'true' : undefined }
                    slot="four"
                    style={ [
                      fieldSet.$.border.clrSlug &&   `border-color: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.border.clrSlug)}`,
                      fieldSet.$.background.clrSlug &&   `background: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.background.clrSlug)}`,
                      fieldSet.$.text.clrSlug &&   `color: ${getCssColourForThemePreview(tokens, brightness, fieldSet.$.text.clrSlug)}`,
                    ].filter( v => v ).join(';') }
                    type="text"
                    value ={ variation === '$' ? undefined : `This is a ${variation} input.` }
                /> 
            ) ) }
        </LoremIpsum>
        <slot name="preview" />
    ) }
</article>

<style lang='scss'>
    @forward '../scss/theme-mode-swatch';
</style>
