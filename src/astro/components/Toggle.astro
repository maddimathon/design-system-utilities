---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */

/* import - values */
import { SampleTokens_Json } from '../functions/index.js';

/* import - components */
import { Toggle as UtilsToggle } from '@maddimathon/utility-astro/components';

/* import - layouts */

/* PROPS ===================================== */

type Props = ComponentProps<typeof UtilsToggle> & {
    tokens?: Tokens.JsonReturn;
};

const { tokens = SampleTokens_Json, ...props }: Props = Astro.props;

/* CONSTANTS ===================================== */

const iconSVG =
    '<span class="icon icon--toggle | toggle-icon">' +
    tokens.icons.toggle.svgInlineLabelled.trim() +
    '</span>';
---

<UtilsToggle
    {...props}
    iconSVG={iconSVG}
    ><slot
        slot='button'
        name='button'
    /><slot /></UtilsToggle
>
