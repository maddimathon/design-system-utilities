---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    HeadingComponentType,
    LoremIpsumComponentType,
    ToggleComponentType,
} from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

import type { AlertComponentType } from './Alert.astro';
import type { LoremIpsumProps } from './LoremIpsum.astro';
import type { ThemeModeSwatchProps_Components } from './ThemeModeSwatch.astro';
import type { WidgetComponentType } from './Widget.astro';

/* import - functions */
import { toTitleCase } from '@maddimathon/utility-typescript';

import { getLevelsInUse } from '../../ts/02-tokens/getLevelsInUse.js';
import { parseThemeSets } from './PageContent_Theme.astro';

/* import - values */

/* import - components */
import {
    Fieldset as FieldsetComponent,
    FormField as FormFieldComponent,
    Heading as HeadingComponent,
} from '@maddimathon/utility-astro/components';

import AlertComponent from './Alert.astro';
import LoremIpsumComponent from './LoremIpsum.astro';
import ThemeModeSwatch from './ThemeModeSwatch.astro';
import ToggleComponent from './Toggle.astro';
import WidgetComponent from './Widget.astro';
import type { PartialExcept } from '@maddimathon/utility-typescript/types';

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

type Props_Components = {
    Alert: AlertComponentType;
    Heading: HeadingComponentType;

    /**
     * @since 0.1.0-beta.0
     * @since 0.1.0-beta.3 — Moved to a components prop.
     */
    LoremIpsum: LoremIpsumComponentType;

    /**
     * @since 0.1.0-beta.0
     * @since 0.1.0-beta.3 — Moved to a components prop.
     */
    Toggle: ToggleComponentType;

    Widget: WidgetComponentType;
} & PartialExcept<LoremIpsumProps.Components, 'Fieldset' | 'FormField'> &
    Partial<ThemeModeSwatchProps_Components>;

interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> {
    tokens: Tokens.JsonReturn<T_Types>;

    /**
     * @since 0.1.0-beta.3
     */
    components?: Partial<Props_Components>;

    defaultPreviewToOpen?: boolean;
    defaultTokensToOpen?: boolean;

    heading?: number;
    displayHeading?: number;
    displayHeading_swatch?: number;

    /**
     * @since 0.1.0-beta.3
     */
    levelsInUseTable?: 'prepend' | 'append';
}

const {
    heading = 2,
    displayHeading = -1,
    displayHeading_swatch = 2,

    components: inputComponents = {},

    defaultPreviewToOpen = true,
    defaultTokensToOpen = false,
    levelsInUseTable,
    tokens,
}: Props = Astro.props;

const components = {
    ...inputComponents,

    Alert: inputComponents.Alert ?? AlertComponent,
    Fieldset: inputComponents.Fieldset ?? FieldsetComponent,
    FormField: inputComponents.FormField ?? FormFieldComponent,
    Heading: inputComponents.Heading ?? HeadingComponent,
    LoremIpsum: inputComponents.LoremIpsum ?? LoremIpsumComponent,
    Toggle: inputComponents.Toggle ?? ToggleComponent,
    Widget: inputComponents.Widget ?? WidgetComponent,
} satisfies Props_Components;

const { Alert, Fieldset, FormField, Heading, LoremIpsum, Toggle, Widget } =
    components;

/* CONSTANTS ===================================== */

const themeNames = Object.keys(tokens.themes).filter(
    (key) => key !== '_meta',
) as (keyof Omit<typeof tokens.themes, '_meta'>)[];

const hasMultipleThemes = themeNames.length > 1;

const levelsInUse = getLevelsInUse(tokens.themes);

const light_parsed = parseThemeSets(tokens, ['light']);

const brightnessOptions = [
    {
        label: 'Light',
        value: 'light',
        parsed: light_parsed,
    },
    {
        label: 'Dark',
        value: 'dark',
        parsed: parseThemeSets(tokens, ['dark']),
    },
] as const satisfies {
    label: string;
    value: string;
    parsed: undefined | ReturnType<typeof parseThemeSets>;
}[];

const themeOptions = themeNames.map(
    (themeKey) =>
        ({
            label: toTitleCase(themeKey),
            value: themeKey,
        }) as const satisfies {
            label: string;
            value: string;
        },
);

const default_brightnessSet = {
    ...light_parsed[0]?.parsed[0],
    value_default: light_parsed[0]?.parsed[0]?.values.filter(
        ({ contrast }) => contrast === 'average',
    )[0],
};
---

<p>
    The following colour shade levels are in use in at least one of the themes
    below: {
        Array.from(levelsInUse).map((level, i) =>
            i < levelsInUse.size - 1 ? (
                <Fragment set:html={`<code>${level}</code>, `} />
            ) : (
                <Fragment set:html={`and <code>${level}</code>.`} />
            ),
        )
    }
</p>

<section class='theme-dynamic-preview__display-options'>
    <h2 class='screen-reader-text'>Display Options</h2>

    <Fieldset
        data-tokens-theme-dynamic-preview-brightness-options={brightnessOptions
            .map(({ value }) => value)
            .join(',')}
    >
        <legend>Brightness</legend>
        <div class='container'>
            {
                brightnessOptions.map(({ label, value }) => (
                    <FormField
                        class='theme-dynamic-preview__display-options__label'
                        labelAttrs={{
                            class: 'theme-dynamic-preview__display-options__label',
                        }}
                        name='theme-dynamic-preview__display-options__brightness-control'
                        type='radio'
                        value={value}
                    >
                        <Fragment slot='label'>{label}</Fragment>
                    </FormField>
                ))
            }
        </div>
    </Fieldset>

    <Fieldset
        data-tokens-theme-dynamic-preview-theme-options={themeNames.join(',')}
    >
        <legend>Theme Set</legend>
        <div class='container'>
            {
                themeOptions.map(({ label, value }) => (
                    <FormField
                        class='theme-dynamic-preview__display-options__label'
                        labelAttrs={{
                            class: 'theme-dynamic-preview__display-options__label',
                        }}
                        name='theme-dynamic-preview__display-options__theme-control'
                        type='radio'
                        value={value}
                    >
                        <Fragment slot='label'>{label}</Fragment>
                    </FormField>
                ))
            }
        </div>
    </Fieldset>

    <slot name='display-options' />
</section>

<Toggle
    class='theme-mode-toggle'
    defaultOpen={defaultPreviewToOpen}
    displayHeading={displayHeading}
    heading={heading}
    id={'theme-preview'}
>
    <Fragment slot='button'
        ><span
            aria-ignore='true'
            set:text='Preview'
        /><span
            class='screen-reader-text'
            set:text={` Styles preview (for theme and brightness mode selected above)`}
        /></Fragment
    >
    <div
        class:list={['theme-mode-toggle__list']}
        style={`--theme-mode-swatch-list-column-count: ${default_brightnessSet.values?.length ?? 4};`}
    >
        {
            default_brightnessSet.values?.map((set) => (
                <ThemeModeSwatch
                    {...{
                        ...set,
                        components,
                        displayHeading: displayHeading_swatch,
                        displayMode: 'preview',
                        heading: heading + 1,
                        id: `${set.id}-swatch`,
                        levelsInUseTable,
                        tokens,
                    }}
                    data-active-theme={light_parsed[0]?.key}
                    data-contrast-mode={set.contrast}
                    data-tokens-theme-preview-container
                    data-tokens-theme-dynamic-preview-preview-container
                >
                    <Fragment
                        slot='heading'
                        set:text={`${toTitleCase(set.contrast)} Contrast`}
                    />
                    {Object.keys(set.theme.data.background).length > 1 && (
                        <div
                            class='theme-mode-swatch__alt-widgets'
                            slot='preview'
                        >
                            {Object.entries(set.theme.data.background).map(
                                ([backgroundSlug, backgroundClrName]) =>
                                    backgroundSlug !== '$' && (
                                        <Alert
                                            class:list={`alert-block--${backgroundSlug} background-${backgroundSlug}`}
                                            icon={
                                                tokens.icons[backgroundSlug] ??
                                                tokens.icons.star
                                            }
                                            style={`background: var(--theme-background-${backgroundSlug}, var(--clr-${backgroundClrName}))`}
                                        >
                                            <Fragment slot='headline'>
                                                Alert Block:{' '}
                                                <samp
                                                    set:text={`background-${backgroundSlug}`}
                                                />
                                            </Fragment>
                                            <LoremIpsum
                                                components={components}
                                                displayHeading={7}
                                                displaySettings={{
                                                    // @ts-expect-error
                                                    photos: false,
                                                    toc: false,
                                                }}
                                                heading={5}
                                                mode={
                                                    import.meta.env.DEV
                                                        ? 'library'
                                                        : 'minimum'
                                                }
                                                superAbbreviated={true}
                                                tokens={tokens}
                                                Toggle={Toggle}
                                            />
                                        </Alert>
                                    ),
                            )}
                        </div>
                    )}
                    {hasMultipleThemes && (
                        <div
                            class='main-sidebar theme-mode-swatch__alt-widgets'
                            slot='preview'
                        >
                            {[null, ...themeNames].map((themeName) => (
                                <Widget
                                    components={components}
                                    displayHeading={3}
                                    heading={5}
                                    class:list={'widget-block--alt-theme'}
                                    data-tokens-theme-preview-container
                                    data-tokens-theme-dynamic-preview-preview-container='brightness-only'
                                    data-active-theme={themeName ?? ''}
                                    data-contrast-mode={set.contrast}
                                >
                                    <Fragment
                                        slot='heading'
                                        set:text='Theme Demo Widget'
                                    />
                                    {themeName ? (
                                        <Fragment slot='subheading'>
                                            This is the{' '}
                                            <samp
                                                set:text={toTitleCase(
                                                    themeName,
                                                )}
                                            />{' '}
                                            theme
                                        </Fragment>
                                    ) : (
                                        <Fragment slot='subheading'>
                                            This inherits the parent’s theme
                                        </Fragment>
                                    )}
                                    <LoremIpsum
                                        components={components}
                                        displayHeading={4}
                                        displaySettings={{
                                            buttons: false,
                                            buttonTypes: false,
                                            buttonVariationsAll: false,
                                            disabledButton: false,
                                            // @ts-expect-error
                                            photos: false,
                                            toc: false,
                                        }}
                                        heading={6}
                                        mode={
                                            import.meta.env.DEV
                                                ? 'fancy'
                                                : 'library'
                                        }
                                        superAbbreviated={true}
                                        tokens={tokens}
                                    />
                                </Widget>
                            ))}
                        </div>
                    )}
                </ThemeModeSwatch>
            ))
        }
    </div>
</Toggle>

<Toggle
    class='theme-mode-toggle'
    defaultOpen={defaultTokensToOpen}
    displayHeading={displayHeading}
    heading={heading}
    id={'theme-tokens'}
>
    <Fragment
        set:text={'Token Values'}
        slot='button'
    />
    {
        brightnessOptions.map(
            ({ label: brightnessLabel, value: brightness, parsed }) => (
                <div
                    data-tokens-theme-dynamic-preview-brightness-content={
                        brightness
                    }
                >
                    <Heading
                        class='screen-reader-text'
                        heading={heading + 1}
                        set:text={`${brightnessLabel} Mode`}
                    />
                    {parsed.map((parsedTheme) =>
                        parsedTheme.parsed.map((brightnessSet) => (
                            <div
                                class:list={['theme-mode-toggle__list']}
                                data-tokens-theme-dynamic-preview-theme-content={
                                    parsedTheme.key
                                }
                                style={`--theme-mode-swatch-list-column-count: ${brightnessSet.values.length};`}
                            >
                                {brightnessSet.values.map((set) => (
                                    <ThemeModeSwatch
                                        {...{
                                            ...set,
                                            components,
                                            displayHeading:
                                                displayHeading_swatch,
                                            displayMode: 'tokens',
                                            heading: heading + 2,
                                            id: `${set.id}-token-values`,
                                            levelsInUseTable,
                                            tokens,
                                        }}
                                        data-active-theme={set.theme.name}
                                        data-brightness-mode={set.brightness}
                                        data-contrast-mode={set.contrast}
                                        data-tokens-theme-preview-container
                                    >
                                        <Fragment
                                            slot='heading'
                                            set:text={`${toTitleCase(set.contrast)} Contrast`}
                                        />
                                    </ThemeModeSwatch>
                                ))}
                            </div>
                        )),
                    )}
                </div>
            ),
        )
    }
</Toggle>

<style lang='scss'>
    @forward '../scss/page-content-theme-dynamic';
</style>

<script>
    import {
        objectFromEntries,
        objectMap,
    } from '@maddimathon/utility-typescript';

    /**
     * Listens to options inputs and updates attribute values accordingly.
     */
    class ThemeDynamicManager {
        /**
         * These are the attribute names applied to the root element whose values
         * represent the brightness mode and active theme to display.
         */
        public static readonly attrNames = {
            brightness: 'data-tokens-theme-dynamic-preview-brightness',
            custom: 'data-tokens-theme-dynamic-preview-custom',
            theme: 'data-tokens-theme-dynamic-preview-theme',
        } as const;

        /**
         * These containers get their data attributes set whenever a new value is set.
         */
        public readonly dynamicPreviewContainers: HTMLElement[];

        /**
         * These containers get their data attributes set whenever a new custom value is set.
         */
        public readonly previewContainers: HTMLElement[];

        /**
         * These inputs let users select the brightness mode and active theme values.
         */
        public readonly inputs: {
            brightness: HTMLInputElement[];
            custom: {
                [key: string]: HTMLInputElement[];
            };
            theme: HTMLInputElement[];
        };

        /**
         * All allowed options.
         */
        public readonly brightnessOptions: string[];

        /**
         * All allowed options.
         */
        public readonly themeOptions: null | string[];

        /**
         * All custom options, indexed by the attribute name.
         */
        public readonly customOptions: {
            [key: string]: {
                default: string | null;
                opts: string[];
            };
        };

        public constructor() {
            this.brightnessOptions = document
                .querySelector<HTMLFieldSetElement>(
                    `fieldset[${ThemeDynamicManager.attrNames.brightness}-options]`,
                )
                ?.getAttribute(
                    `${ThemeDynamicManager.attrNames.brightness}-options`,
                )
                ?.split(',') ?? ['light', 'dark'];

            this.themeOptions =
                document
                    .querySelector<HTMLFieldSetElement>(
                        `fieldset[${ThemeDynamicManager.attrNames.theme}-options]`,
                    )
                    ?.getAttribute(
                        `${ThemeDynamicManager.attrNames.theme}-options`,
                    )
                    ?.split(',') ?? null;

            const customOptions = Array.from(
                document.querySelectorAll<HTMLFieldSetElement>(
                    `fieldset[${ThemeDynamicManager.attrNames.custom}-attr][${ThemeDynamicManager.attrNames.custom}-options]`,
                ),
                (fieldset) => {
                    const opts =
                        fieldset
                            .getAttribute(
                                `${ThemeDynamicManager.attrNames.custom}-options`,
                            )
                            ?.split(',') ?? null;

                    return [
                        fieldset.getAttribute(
                            `${ThemeDynamicManager.attrNames.custom}-attr`,
                        ),
                        opts
                            ? {
                                  default: fieldset.getAttribute(
                                      `${ThemeDynamicManager.attrNames.custom}-default`,
                                  ),
                                  opts,
                              }
                            : null,
                    ] as const;
                },
            ).filter(
                (
                    arr,
                ): arr is [
                    NonNullable<(typeof arr)[0]>,
                    NonNullable<(typeof arr)[1]>,
                ] => !!arr[0] && !!arr[1],
            );

            console.log({ customOptions });

            this.customOptions = objectFromEntries(customOptions);

            console.log({ 'this.customOptions': this.customOptions });

            this.inputs = {
                brightness: Array.from(
                    document.querySelectorAll<HTMLInputElement>(
                        'input[name=theme-dynamic-preview__display-options__brightness-control]',
                    ),
                ),

                custom: objectMap(this.customOptions, ([key, value]) =>
                    Array.from(
                        document.querySelectorAll<HTMLInputElement>(
                            `input[name=theme-dynamic-preview__display-options__${key}]`,
                        ),
                    ),
                ),

                theme: Array.from(
                    document.querySelectorAll<HTMLInputElement>(
                        'input[name=theme-dynamic-preview__display-options__theme-control]',
                    ),
                ),
            };

            console.log({ 'this.inputs.custom': this.inputs.custom });

            this.previewContainers = Array.from(
                document.querySelectorAll<HTMLElement>(
                    '[data-tokens-theme-preview-container]',
                ),
            );

            this.dynamicPreviewContainers = Array.from(
                document.querySelectorAll<HTMLElement>(
                    '[data-tokens-theme-dynamic-preview-preview-container]',
                ),
            );

            for (const __key in ThemeDynamicManager.attrNames) {
                const _key =
                    __key as keyof typeof ThemeDynamicManager.attrNames;

                // continues
                if (_key === 'custom') {
                    continue;
                }

                const _local = localStorage.getItem(
                    ThemeDynamicManager.attrNames[_key],
                );

                switch (_key) {
                    case 'brightness':
                        this.setBrightnessValue(_local ?? 'light', true);
                        break;

                    case 'theme':
                        this.setThemeValue(_local ?? 'default', true);
                        break;
                }
            }

            this.inputs.brightness.forEach((input) =>
                input.addEventListener('change', (event) => {
                    // returns - this is not an input we take action on
                    if (!input.checked) {
                        return;
                    }

                    this.setBrightnessValue(input.value, false);
                }),
            );

            this.inputs.theme.forEach((input) =>
                input.addEventListener('change', () => {
                    // returns - this is not an input we take action on
                    if (!input.checked) {
                        return;
                    }

                    this.setThemeValue(input.value, false);
                }),
            );

            for (const _attr in this.customOptions) {
                const _local = localStorage.getItem(
                    `${ThemeDynamicManager.attrNames.custom}-${_attr}`,
                );

                this.setCustomValue(
                    _attr,
                    _local ?? this.customOptions[_attr]?.default ?? null,
                    true,
                );

                this.inputs.custom[_attr]?.forEach((input) =>
                    input.addEventListener('change', () => {
                        // returns - this is not an input we take action on
                        if (!input.checked) {
                            return;
                        }

                        this.setCustomValue(_attr, input.value, false);
                    }),
                );
            }
        }

        protected static async _setValue_dynamicPreviewContainers(
            container: HTMLElement,
            dynamicPreviewAttrKey: string,
            newValue: string,
        ) {
            container.setAttribute(dynamicPreviewAttrKey, newValue);
        }

        protected async _setValue(
            key: keyof typeof ThemeDynamicManager.attrNames,
            dynamicPreviewAttrKey: string,
            newValue: string,
            controllerSignal: AbortSignal,
            setInputValues: boolean = false,
        ) {
            return new Promise<void>((resolve) => {
                if (controllerSignal.aborted) {
                    resolve();
                    return;
                }

                let unresolved = true;
                const doubleResolve = () => {
                    resolve();
                    unresolved = false;
                };

                controllerSignal.addEventListener('abort', doubleResolve);

                if (!unresolved) {
                    return;
                }

                const storageKey =
                    key === 'custom'
                        ? `${ThemeDynamicManager.attrNames.custom}-${dynamicPreviewAttrKey}`
                        : ThemeDynamicManager.attrNames[key];

                const rootAttribute =
                    key === 'custom'
                        ? `${ThemeDynamicManager.attrNames.custom}-${dynamicPreviewAttrKey}`
                        : ThemeDynamicManager.attrNames[key];

                document.documentElement.setAttribute(rootAttribute, newValue);

                if (!unresolved) {
                    return;
                }

                const promises: Promise<any>[] = (
                    key === 'custom'
                        ? this.previewContainers
                        : this.dynamicPreviewContainers
                ).map(async (container) => {
                    // returns
                    if (
                        container.getAttribute(
                            'data-tokens-theme-dynamic-preview-preview-container',
                        ) === 'brightness-only' &&
                        key !== 'brightness' &&
                        key !== 'custom'
                    ) {
                        return;
                    }

                    return ThemeDynamicManager._setValue_dynamicPreviewContainers(
                        container,
                        key === 'custom'
                            ? `data-${dynamicPreviewAttrKey}`
                            : dynamicPreviewAttrKey,
                        newValue,
                    );
                });

                if (setInputValues) {
                    if (key === 'custom') {
                        console.log({
                            '_setValue()': {
                                dynamicPreviewAttrKey,
                                newValue,
                                setInputValues,
                                'this.customOptions[dynamicPreviewAttrKey].default':
                                    this.customOptions[dynamicPreviewAttrKey]
                                        ?.default,
                                'this.customOptions[dynamicPreviewAttrKey].opts':
                                    this.customOptions[dynamicPreviewAttrKey]
                                        ?.opts,
                                'this.inputs.custom[dynamicPreviewAttrKey]':
                                    this.inputs.custom[dynamicPreviewAttrKey],
                            },
                        });
                        for (const input of this.inputs.custom[
                            dynamicPreviewAttrKey
                        ] ?? []) {
                            if (!unresolved) {
                                return;
                            }
                            input.checked = input.value === newValue;
                        }
                    } else {
                        for (const input of this.inputs[key]) {
                            if (!unresolved) {
                                return;
                            }
                            input.checked = input.value === newValue;
                        }
                    }
                }

                if (!unresolved) {
                    return;
                }

                localStorage.setItem(storageKey, newValue);

                setTimeout(
                    () => Promise.all(promises).then(doubleResolve),
                    300,
                );
            });
        }

        private abortController_setBrightnessValue: undefined | AbortController;

        protected async setBrightnessValue(
            newValue: string,
            setInputValues?: boolean,
        ) {
            this.abortController_setBrightnessValue?.abort();
            this.abortController_setBrightnessValue = new AbortController();

            if (!this.brightnessOptions.includes(newValue)) {
                newValue = 'light';
            }

            return this._setValue(
                'brightness',
                'data-brightness-mode',
                newValue,
                this.abortController_setBrightnessValue.signal,
                setInputValues,
            ).then(() => (this.abortController_setBrightnessValue = undefined));
        }

        private abortController_setCustomValue: undefined | AbortController;

        protected async setCustomValue(
            attr: string,
            newValue: string | null,
            setInputValues?: boolean,
        ) {
            console.log({
                'setCustomValue()': {
                    attr,
                    newValue,
                    setInputValues,
                    'this.customOptions[attr].default':
                        this.customOptions[attr]?.default,
                    'this.customOptions[attr].opts':
                        this.customOptions[attr]?.opts,
                },
            });

            this.abortController_setCustomValue?.abort();
            this.abortController_setCustomValue = new AbortController();

            newValue = newValue ?? this.customOptions[attr]?.default ?? null;

            // returns
            if (
                !newValue ||
                !this.customOptions[attr]?.opts.includes(newValue)
            ) {
                return;
            }

            return this._setValue(
                'custom',
                attr,
                newValue,
                this.abortController_setCustomValue.signal,
                setInputValues,
            ).then(() => (this.abortController_setCustomValue = undefined));
        }

        private abortController_setThemeValue: undefined | AbortController;

        protected async setThemeValue(
            newValue: string,
            setInputValues?: boolean,
        ) {
            this.abortController_setThemeValue?.abort();
            this.abortController_setThemeValue = new AbortController();

            if (
                this.themeOptions?.length &&
                !this.themeOptions.includes(newValue)
            ) {
                newValue = 'default';
            }

            return this._setValue(
                'theme',
                'data-active-theme',
                newValue,
                this.abortController_setThemeValue.signal,
                setInputValues,
            ).then(() => (this.abortController_setThemeValue = undefined));
        }
    }

    new ThemeDynamicManager();
</script>
