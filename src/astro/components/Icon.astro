---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ElementProps } from '@maddimathon/utility-astro';
import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - values */

/* import - components */

/* import - layouts */

/* PROPS ===================================== */

export type IconProps = {
    icon: SvgMaker.JsonReturn;
    svgType?: 'hidden' | 'labelled' | undefined;
};

type Props = ElementProps<IconProps, 'span'>;

const {
    'aria-hidden': ariaHidden,
    'class': classList,
    icon,
    slot,
    svgType = ariaHidden ? 'hidden' : 'labelled',
    ...attributes
}: Props = Astro.props;
---

<span
    {...attributes}
    aria-hidden={ariaHidden ? true : undefined}
    class={makeClassList.flat(['icon', `icon--${icon.slug}`], classList)}
    set:html={svgType === 'hidden'
        ? icon.svgInlineHidden.trim()
        : icon.svgInlineLabelled.trim()}
/>
