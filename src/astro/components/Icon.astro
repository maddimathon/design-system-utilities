---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '@maddimathon/utility-astro';
import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */

/* import - layouts */

/* PROPS ===================================== */

type IconProps = {
    icon: SvgMaker.JsonReturn;
};

export type Props = GenericElementProps<IconProps, 'span'>;

const {
    'aria-hidden': ariaHidden = true,
    'class': classList,
    icon,
    slot,
    ...attributes
}: Props = Astro.props?.frontmatter ?? Astro.props;
---

<span
    {...attributes}
    aria-hidden={!!ariaHidden}
    class:list={['icon', `icon--${icon.slug}`, '||', classList]}
>
    <Fragment set:html={icon.svgInlineLabelled} />
</span>

<style lang='scss'>
    @forward '../css/icon.css';
</style>
