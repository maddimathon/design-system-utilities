---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '@maddimathon/utility-astro';
import type { AlertProps as UtilsAlertProps } from '@maddimathon/utility-astro/components/Alert';
import type { AlertIconProps_Render } from '@maddimathon/utility-astro/components/Alert_Icon';
import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import UtilsAlert from '@maddimathon/utility-astro/components/Alert';
import Icon from './Icon.astro';
// import Icon from './Icon.astro';

/* import - layouts */

/* PROPS ===================================== */

export interface AlertProps extends UtilsAlertProps<AlertIconProps_Render> {
    icon: SvgMaker.JsonReturn;
}

export type Props = GenericElementProps<AlertProps, 'section'>;

const { icon, class: classList = [], ...attributes }: Props = Astro.props;

/* CONSTANTS ===================================== */
---

<UtilsAlert
    class:list={[{ 'alert-block--has-heading': attributes.heading }, classList]}
    {...attributes}
>
    <Icon
        slot='icon'
        icon={icon}
    />
    <slot
        slot='headline'
        name='headline'
    />
    <slot />
</UtilsAlert>
