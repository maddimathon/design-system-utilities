---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '@maddimathon/utility-astro';

import type {
    AlertProps as UtilsAlertProps,
    AlertIconProps_Render,
} from '@maddimathon/utility-astro/components';

import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import { Alert as UtilsAlert } from '@maddimathon/utility-astro/components';
import Icon from './Icon.astro';
// import Icon from './Icon.astro';

/* import - layouts */

/* PROPS ===================================== */

export interface AlertProps extends UtilsAlertProps<AlertIconProps_Render> {
    icon: SvgMaker.JsonReturn;
}

type Props = GenericElementProps<AlertProps, 'section'>;

const { icon, class: classList = [], ...attributes }: Props = Astro.props;

/* CONSTANTS ===================================== */

// @ts-expect-error
attributes.slug = icon.slug;
---

<UtilsAlert
    class:list={[{ 'alert-block--has-heading': attributes.heading }, classList]}
    {...attributes}
>
    <Icon
        slot='icon'
        icon={icon}
    />
    <slot
        slot='headline'
        name='headline'
    />
    <slot />
</UtilsAlert>
