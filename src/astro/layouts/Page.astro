---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { ArrayItem } from '@maddimathon/utility-typescript/types';
import type { GenericProps } from '@maddimathon/utility-astro';

import type { Tokens } from '../../ts/02-tokens/Tokens.js';
import type { Tokens_Typography } from '../../ts/02-tokens/Tokens_Typography.js';

/* import - functions */
import { absoluteInternalURL } from '@maddimathon/utility-astro/functions';

/* import - values */

/* import - components */

/* import - layouts */
import { Page as UtilPage } from '@maddimathon/utility-astro/layouts';

/* TYPES ===================================== */

type Copyright_HTML = {
    /**
     * Escaped HTML to include after the copyright symbol.
     *
     * True adds default credit with link to maddimathon.com.
     */
    html: string | true;

    owner?: undefined;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year?: number;
};

type Copyright_PlainOwner = {
    html?: undefined;

    /**
     * Text to follow the copyright symbol and date.
     *
     * *Text to be escaped, NOT html.*
     */
    owner: string;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year?: number;
};

type Copyright_PlainYear = {
    html?: undefined;

    /**
     * Text to follow the copyright symbol and date.
     *
     * *Text to be escaped, NOT html.*
     */
    owner?: string | undefined;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year: number;
};

/* PROPS ===================================== */

type UtilPage_Props = Omit<ComponentProps<typeof UtilPage>, 'frontmatter'>;

type Partial_LibProps = Partial<Omit<UtilPage_Props, 'footer' | 'settings'>> &
    Pick<UtilPage_Props, 'meta' | 'title'>;

export interface PageProps extends Partial_LibProps {
    tokens: Tokens.JsonReturn;

    footer?: {
        // prettier-ignore
        copyright?: false | Copyright_HTML | Copyright_PlainOwner | Copyright_PlainYear;
        designedBy?: boolean | string;
    };

    stylesheetURLs?: string[];
    stylesheetVersion?: string;

    urlMaker?: (currentURL: URL, targetSubpath: string) => string;
}

export interface Props extends GenericProps<PageProps> {}

const inputs: Props = Astro.props?.['frontmatter'] ?? Astro.props;

const urlMaker = inputs?.urlMaker ?? absoluteInternalURL;

const _settings: UtilPage_Props['settings'] = {
    settings: {
        brightness: true,
        contrast: {
            max: true,
        },
        motion: true,
    },
};

function parseFooterInput(_input?: Required<PageProps>['footer']['copyright']) {
    const _useDefaultFooter =
        _input !== false &&
        (typeof _input === 'undefined' || _input?.html === true);

    type InputFooterType_IfUseDefaultFooter = Exclude<
        Required<PageProps>['footer']['copyright'],
        false | Copyright_PlainOwner | Copyright_PlainYear
    >;

    // prettier-ignore
    type InputFooterType_NotUseDefaultFooter = Extract<
        Required<PageProps>['footer']['copyright'],
        false | Copyright_PlainOwner | Copyright_PlainYear
    > | (Omit<Copyright_HTML, 'html'> & { html: string });

    // returns
    if (_useDefaultFooter) {
        const inputFooter = _input as InputFooterType_IfUseDefaultFooter;

        return {
            html:
                typeof inputFooter?.html !== 'string'
                    ? '<a href="https://www.maddimathon.com" target="_blank">Maddi Mathon</a>'
                    : inputFooter?.html,

            year: inputFooter?.year ?? new Date().getFullYear(),
        };
    }

    return _input as InputFooterType_NotUseDefaultFooter satisfies NonNullable<
        UtilPage_Props['footer']
    >['copyright'];
}

const props = {
    dir: 'ltr',
    lang: 'en',

    convertHrefStringsToAbsolute: false,

    ...inputs,

    footer: {
        copyright: parseFooterInput(inputs.footer?.copyright),

        designedBy:
            inputs.footer?.designedBy === true
                ? `<p class="designer">Custom design and development by <a
                        href="https://www.maddimathon.com/web"
                        target="_blank"
                    >Maddi Mathon</a>. Human-built without the use of generative AI.</p>`
                : inputs.footer?.designedBy
                  ? inputs.footer?.designedBy
                  : undefined,
    },

    settings: _settings,
} satisfies UtilPage_Props;

/* CONSTANTS ===================================== */

/* Stylesheets ------------------ */

const versionSuffix = props.stylesheetVersion
    ? `?v=${props.stylesheetVersion}`
    : '';

const stylesheets = props.stylesheetURLs
    ? [...props.stylesheetURLs].map(
          (_str) => urlMaker(Astro.url, _str) + versionSuffix,
      )
    : [];

/* Menus ------------------ */

const _menuMapper = (_obj: ArrayItem<[] & UtilPage_Props['primaryMenu']>) => {
    _obj = { ..._obj };

    if (typeof _obj.href === 'string') {
        _obj.href = urlMaker(Astro.url, _obj.href);
    }
    if (_obj.child?.length) {
        _obj.child = [..._obj.child].map(_menuMapper);
    }
    return _obj;
};

if (Array.isArray(props.primaryMenu)) {
    props.primaryMenu = [...props.primaryMenu].map(_menuMapper);
}

if (Array.isArray(props.secondaryMenu)) {
    props.secondaryMenu = [...props.secondaryMenu].map(_menuMapper);
}

/* Settings ------------------ */

const familyOverrideValues = inputs.tokens.typography.familyOverrides
    ? (Object.values(inputs.tokens.typography.familyOverrides).filter(
          (v) => v,
      ) as Tokens_Typography.Font.FamilyOverride[])
    : [];

if (familyOverrideValues.length) {
    if (!props.settings.settings) {
        props.settings.settings = {};
    }

    const fontOverrideOptions: NonNullable<
        typeof props.settings.settings.custom
    >[number]['options'] = [
        {
            label: 'Default',
            value: 'default',
            labelClass: 'font-family-override-default',
        },
        ...(familyOverrideValues ?? []),
    ];

    props.settings.settings.custom = [
        {
            id: 'font-family-override',
            label: 'Font Override',
            default: 'default',
            options: fontOverrideOptions,
        },
        ...(props.settings.settings.custom ?? []),
    ];
}

/* Slots ------------------ */

const footerTextHTML =
    Astro.slots.has('footer-text') &&
    (await Astro.slots.render('footer-text'))?.trim();
---

<UtilPage
    {...props as UtilPage_Props}
    layout={props.layout || 'content-only'}
>
    <slot
        slot='head-open'
        name='head-open'
    />

    {
        stylesheets.map((url) => (
            <link
                slot='head-open'
                rel='preload'
                href={url}
                as='style'
            />
        ))
    }
    {
        stylesheets.map((url) => (
            <link
                slot='head-open'
                rel='stylesheet'
                href={url}
            />
        ))
    }

    <slot
        slot='head-close'
        name='head-close'
    />

    <meta
        slot='head-close'
        name='color-scheme'
        content='dark light'
    />

    <slot
        slot='body-open'
        name='body-open'
    />

    <p
        slot='settings-menu-open'
        class='website-settings__disclaimer'
    >
        These settings are saved using browser cookies, which may not work as
        expected in offline copies.
    </p>
    <slot
        slot='settings-menu-open'
        name='settings-menu-open'
    />

    <slot
        slot='settings-menu'
        name='settings-menu'
    />
    <slot
        slot='settings-menu-close'
        name='settings-menu-close'
    />

    <slot
        slot='before-header'
        name='before-header'
    />

    <slot
        slot='header'
        name='header'
    />

    <slot
        slot='before-primary-nav'
        name='before-primary-nav'
    />

    <slot
        slot='after-primary-nav'
        name='after-primary-nav'
    />

    <slot
        slot='after-header'
        name='after-header'
    />

    <slot
        slot='content-header'
        name='content-header'
    />

    <slot
        slot='before-site-content'
        name='before-site-content'
    />

    <slot />

    <slot
        slot='after-site-content'
        name='after-site-content'
    />

    <slot
        slot='sidebar'
        name='sidebar'
    />

    <slot
        slot='before-secondary-nav'
        name='before-secondary-nav'
    />

    <slot
        slot='after-secondary-nav'
        name='after-secondary-nav'
    />

    <slot
        slot='before-footer'
        name='before-footer'
    />

    <slot
        slot='footer'
        name='footer'
    />

    {
        footerTextHTML && (
            <div
                class='site-footer__text'
                set:html={footerTextHTML}
                slot='footer'
            />
        )
    }

    <slot
        slot='after-footer'
        name='after-footer'
    />

    <slot
        slot='body-close'
        name='body-close'
    />

    <slot
        slot='footer-scripts'
        name='footer-scripts'
    />
</UtilPage>
