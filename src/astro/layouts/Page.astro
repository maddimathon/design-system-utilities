---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ArrayItem } from '@maddimathon/utility-typescript/types';

import type { GenericProps } from '@maddimathon/utility-astro';
import type { SettingsMenuProps } from '@maddimathon/utility-astro/components';
import type {
    ContentTypeInput,
    DefaultContentType,
    PageProps as LibPageProps,
} from '@maddimathon/utility-astro/layouts';

import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */
import { absoluteInternalURL } from '@maddimathon/utility-astro/functions';

/* import - values */

/* import - components */
import astroComponents from '../components.ts';

/* import - layouts */
import { Page as UtilPage } from '@maddimathon/utility-astro/layouts';

/* TYPES ===================================== */

type Copyright_HTML = {
    /**
     * Escaped HTML to include after the copyright symbol.
     *
     * True adds default credit with link to maddimathon.com.
     */
    html: string | true;

    owner?: undefined;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year?: number | false | undefined;
};

type Copyright_PlainOwner = {
    html?: undefined;

    /**
     * Text to follow the copyright symbol and date.
     *
     * *Text to be escaped, NOT html.*
     */
    owner: string;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year?: number | false;
};

type Copyright_PlainYear = {
    html?: undefined;

    /**
     * Text to follow the copyright symbol and date.
     *
     * *Text to be escaped, NOT html.*
     */
    owner?: string | undefined;

    /**
     * If undefined, this defaults to the current year. If it is greater
     * than the current year, this is displayed as a range.
     *
     * *Text to be escaped, NOT html.*
     */
    year: number | false;
};

/* FUNCTIONS ===================================== */

/**
 * Parses Page layout input props into a more consistent output.
 *
 * @since 0.1.0
 */
export function parsePageProps<
    T_ContentType extends ContentTypeInput = DefaultContentType,
>(
    currentURL: URL,
    defaultComponents: typeof astroComponents,
    {
        components: inputComponents,
        dir = 'ltr',
        lang = 'en',
        primaryMenu,
        secondaryMenu,
        settings: inputSettings,
        stylesheetPreload = true,
        stylesheetURLs,
        stylesheetVersion = import.meta.env.BRAND_KIT_VERSION_STYLESHEET,
        urlMaker = absoluteInternalURL,
        ...inputs
    }: PageProps<T_ContentType>,
) {
    const parseFooterInput = (
        _input?: Required<PageProps>['footer']['copyright'],
    ) => {
        const _useDefaultFooter =
            typeof _input === 'undefined' || _input?.html === true;

        type InputFooterType_IfUseDefaultFooter = Exclude<
            Required<PageProps>['footer']['copyright'],
            false | Copyright_PlainOwner | Copyright_PlainYear
        >;

        // prettier-ignore
        type InputFooterType_NotUseDefaultFooter = Extract<
            Required<PageProps>['footer']['copyright'],
            false | Copyright_PlainOwner | Copyright_PlainYear
        > | (Omit<Copyright_HTML, 'html'> & { html: string });

        // returns
        if (_useDefaultFooter) {
            const inputFooter = _input as InputFooterType_IfUseDefaultFooter;

            return {
                html:
                    typeof inputFooter?.html !== 'string'
                        ? '<a href="https://www.maddimathon.com/web" target="_blank">Maddi Mathon</a>'
                        : inputFooter?.html,

                year: inputFooter?.year ?? new Date().getFullYear(),
            };
        }

        return _input as InputFooterType_NotUseDefaultFooter satisfies NonNullable<
            LibPageProps['footer']
        >['copyright'];
    };

    const convertHrefStringsToAbsolute = false;

    const components = {
        ...defaultComponents,
        PrimaryMenu: defaultComponents.ToggleNavMenu,
        ...inputComponents,
    } as const satisfies SettingsMenuProps['components'] &
        PageProps['components'];

    /* Menus ------------------ */

    const _menuMapper = (_obj: ArrayItem<[] & LibPageProps['primaryMenu']>) => {
        _obj = { ..._obj };

        if (typeof _obj.href === 'string') {
            _obj.href = urlMaker(currentURL, _obj.href);
        }
        if (_obj.child?.length) {
            _obj.child = [..._obj.child].map(_menuMapper);
        }
        return _obj;
    };

    if (Array.isArray(primaryMenu)) {
        primaryMenu = [...primaryMenu].map(_menuMapper);
    }

    if (Array.isArray(secondaryMenu)) {
        secondaryMenu = [...secondaryMenu].map(_menuMapper);
    }

    /* Stylesheets ------------------ */

    const stylesheet_versionSuffix = stylesheetVersion
        ? `?v=${stylesheetVersion}`
        : '';

    const stylesheets = stylesheetURLs
        ? [...stylesheetURLs].map(
              (_str) => urlMaker(currentURL, _str) + stylesheet_versionSuffix,
          )
        : [];

    /* Settings ------------------ */

    const settings =
        inputSettings !== false
            ? ({
                  ...inputSettings,

                  components,

                  settings: {
                      ...inputSettings?.settings,

                      brightness: inputSettings?.settings?.brightness ?? true,

                      contrast:
                          inputSettings?.settings?.contrast !== false
                              ? {
                                    max: true,
                                    ...(typeof inputSettings?.settings
                                        ?.contrast === 'object'
                                        ? inputSettings?.settings?.contrast
                                        : {}),
                                }
                              : inputSettings?.settings?.contrast,

                      motion: inputSettings?.settings?.motion ?? true,
                  },

                  tokens: inputs.tokens,
              } satisfies SettingsMenuProps & { tokens: Tokens.JsonReturn })
            : inputSettings;

    const familyOverrideValues = inputs.tokens.typography.familyOverrides
        ? Object.values(inputs.tokens.typography.familyOverrides).filter(
              (v) => !!v,
          )
        : [];

    if (familyOverrideValues.length && settings) {
        const fontOverrideOptions = [
            {
                label: 'Default',
                value: 'default',
                labelClass: 'font-family-override-default',
            },
            ...(familyOverrideValues ?? []),
        ] as const satisfies NonNullable<
            typeof settings.settings.custom
        >[number]['options'];

        settings.settings.custom = [
            {
                id: 'font-family-override',
                label: 'Font Override',
                default: 'default',
                options: fontOverrideOptions,
            },
            ...(settings.settings.custom ?? []),
        ];
    }

    /* Lib Props ------------------ */

    const libProps = {
        ...inputs,

        components,
        convertHrefStringsToAbsolute,
        dir,

        footer: {
            ...inputs.footer,

            copyright: parseFooterInput(inputs.footer?.copyright),

            designedBy:
                inputs.footer?.designedBy === true
                    ? `<p class="designer">Custom design and development by <a
                            href="https://www.maddimathon.com/web"
                            target="_blank"
                        >Maddi Mathon</a>. Human-built without the use of generative AI.</p>`
                    : inputs.footer?.designedBy
                      ? inputs.footer?.designedBy
                      : undefined,
        },

        lang,
        layout: (inputs.layout ||
            ('content-only' satisfies DefaultContentType)) as T_ContentType,

        primaryMenu,
        secondaryMenu,

        settings,

        urlMaker,
    } satisfies LibPageProps<T_ContentType>;

    return {
        ...inputs,
        components,
        convertHrefStringsToAbsolute,
        dir,
        familyOverrideValues,
        lang,
        libProps,
        primaryMenu,
        secondaryMenu,
        settings,
        stylesheetPreload,
        stylesheetVersion,
        stylesheets,
        urlMaker,
    } as const;
}

/* PROPS ===================================== */

type RequiredLibProps = 'meta' | 'title';
type OmittedLibProps =
    RequiredLibProps | 'convertHrefStringsToAbsolute' | 'footer' | 'settings';

export interface PageProps<
    T_ContentType extends ContentTypeInput = ContentTypeInput,
>
    extends
        Partial<Omit<LibPageProps<T_ContentType>, OmittedLibProps>>,
        Pick<LibPageProps<T_ContentType>, RequiredLibProps> {
    tokens: Tokens.JsonReturn;

    footer?: Omit<
        NonNullable<LibPageProps['footer']>,
        'copyright' | 'designedBy'
    > & {
        // prettier-ignore
        copyright?: undefined | Copyright_HTML | Copyright_PlainOwner | Copyright_PlainYear;
        designedBy?: boolean | string;
    };

    /**
     * @since 0.1.0
     */
    settings?: false | Omit<SettingsMenuProps, 'components' | 'id'>;

    /**
     * @default true
     *
     * @since 0.1.0-beta
     */
    stylesheetPreload?: boolean;

    stylesheetURLs?: string[];
    stylesheetVersion?: string;

    urlMaker?: (currentURL: URL, targetSubpath: string) => string;
}

type Props<T_ContentType extends ContentTypeInput = ContentTypeInput> =
    GenericProps<PageProps<T_ContentType>>;

const { libProps, stylesheetPreload, stylesheets } = parsePageProps<
    NonNullable<Props['layout']>
>(Astro.url, astroComponents, Astro.props?.['frontmatter'] ?? Astro.props);

/* CONSTANTS ===================================== */

const footerTextHTML =
    Astro.slots.has('footer-text') &&
    (await Astro.slots.render('footer-text'))?.trim();
---

<UtilPage {...libProps}>
    <slot
        slot='head-open'
        name='head-open'
    />

    {
        stylesheetPreload &&
            stylesheets.map((url) => (
                <link
                    slot='head-open'
                    rel='preload'
                    href={url}
                    as='style'
                />
            ))
    }
    {
        stylesheets.map((url) => (
            <link
                slot='head-open'
                rel='stylesheet'
                href={url}
            />
        ))
    }

    <slot
        slot='head-close'
        name='head-close'
    />

    <meta
        slot='head-close'
        name='color-scheme'
        content='dark light'
    />

    <slot
        slot='body-open'
        name='body-open'
    />

    <slot
        slot='settings-menu-open'
        name='settings-menu-open'
    />

    <slot
        slot='settings-menu'
        name='settings-menu'
    />
    <slot
        slot='settings-menu-close'
        name='settings-menu-close'
    />

    <slot
        slot='before-header'
        name='before-header'
    />

    <slot
        slot='header'
        name='header'
    />

    <slot
        slot='before-primary-nav'
        name='before-primary-nav'
    />

    <slot
        slot='after-primary-nav'
        name='after-primary-nav'
    />

    <slot
        slot='after-header'
        name='after-header'
    />

    <slot
        slot='content-header'
        name='content-header'
    />

    <slot
        slot='before-site-content'
        name='before-site-content'
    />

    <slot />

    <slot
        slot='after-site-content'
        name='after-site-content'
    />

    <slot
        slot='sidebar'
        name='sidebar'
    />

    <slot
        slot='before-secondary-nav'
        name='before-secondary-nav'
    />

    <slot
        slot='after-secondary-nav'
        name='after-secondary-nav'
    />

    <slot
        slot='before-footer'
        name='before-footer'
    />

    <slot
        slot='footer'
        name='footer'
    />

    {
        footerTextHTML && (
            <div
                class='site-footer__text'
                set:html={footerTextHTML}
                slot='footer'
            />
        )
    }

    <slot
        slot='after-footer'
        name='after-footer'
    />

    <slot
        slot='body-close'
        name='body-close'
    />

    <slot
        slot='footer-scripts'
        name='footer-scripts'
    />
</UtilPage>
