{
    "extends": "../../tsconfig.json",
    "include": [
        "../../src/ts/**/*",
        "./src/ts/**/*"
    ],
    "exclude": [],
    "compilerOptions": {
        "allowUnusedLabels": false,
        "baseUrl": "../../",
        "exactOptionalPropertyTypes": true,
        "noEmit": false,
        "outDir": "../../dist/ts/",
        "skipLibCheck": true,
        "sourceMap": false,
        "verbatimModuleSyntax": true
    }
}