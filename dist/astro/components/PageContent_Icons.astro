---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
// import VariableDump from '@maddimathon/utility-astro/components/VariableDump';
import type { TokenTypes } from '../../ts/02-tokens/@types.d.ts';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */
import { arrayUnique } from '@maddimathon/utility-typescript';
import { objectKeySort_Tokens } from '../../ts/01-utilities/objectKeySort_Tokens.js';

/* import - values */

/* import - components */
import Toggle from '@maddimathon/utility-astro/components/Toggle';
import Alert from './Alert.astro';
import Icon from './Icon.astro';
import LoremIpsum from './LoremIpsum.astro';
import Heading from '@maddimathon/utility-astro/components/Heading';

/* import - layouts */

/* PROPS ===================================== */

// prettier-ignore
export interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> {
    defaultIcon?: T_Types['iconNames'];
    inlinePreviews?:boolean;
    subheadingDisplayHeading?: number;
    tokens: Tokens.JsonReturn<T_Types>;
}

const {
    defaultIcon = 'star',
    inlinePreviews = import.meta.env.DEV,
    subheadingDisplayHeading = 6,
    tokens,
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const defaultToggleToOpen = import.meta.env.DEV ? true : undefined;

const defaultIconSvg = tokens.icons[defaultIcon] ?? tokens.icons.star;

const textAndBackgroundKeys = arrayUnique([
    ...tokens.themes._meta.keys.background,
    ...tokens.themes._meta.keys.text,
]).sort(objectKeySort_Tokens.sorter);

const iconsSortedByLabel = Object.entries(tokens.icons).sort(
    (a,b) => {
        if ( a[1].label > b[1].label ) {
                return 1;
            }

            if ( a[1].label < b[1].label ) {
                return -1;
            }

            return 0;
    }
)
---

<h2>All Icons</h2>

<ul class='button-span | tokens-demo-all-icons tokens-demo-all-icons--basic'>
    {
        iconsSortedByLabel.map(([__key,icon]) => !icon.meta?.aliasOf && (
            <li>
                <Icon icon={icon} />
            </li>
        ))
    }
</ul>

{
    inlinePreviews && (
        
        <Toggle
            defaultOpen={import.meta.env.DEV}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="pseudo-icons-preview"
        >
            <Fragment slot='button' set:text='Inline Icons Preview' />
            <ul class='tokens-demo-all-icons-inline'>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class='button-span tokens-demo-all-icons-inline--icon-list'>
                            {/* <li
                                class={`add-${icon.slug}-icon`}
                                set:text={`${icon.label} Default`}
                            /> */}
                            <li
                                class={`add-${icon.slug}-icon-before`}
                                set:text={`${icon.label} Before`}
                            />
                            <li
                                class={`add-${icon.slug}-icon-after`}
                                set:text={`${icon.label} After`}
                            />
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </Toggle>
    
        <Toggle
            defaultOpen={import.meta.env.DEV}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="button-inline-icons-preview"
        >
            <Fragment slot='button' set:text='Button Inline Icons Preview' />
            <ul class='tokens-demo-all-icons-inline tokens-demo-all-icons-inline--buttons'>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class='button-span tokens-demo-all-icons-inline--icon-list'>
                            {/* <li>
                                <a
                                    class={`button | add-${icon.slug}-icon`}
                                    href='#'
                                    set:text={`${icon.label} Default`}
                                />
                            </li> */}

                            <li>
                                <a
                                    class={`button | add-${icon.slug}-icon-before`}
                                    href='#'
                                    set:text={`${icon.label} Before`}
                                />
                            </li>

                            <li>
                                <a
                                    class={`button | add-${icon.slug}-icon-after`}
                                    href='#'
                                    set:text={`${icon.label} After`}
                                />
                            </li>
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </Toggle>
    
        <Toggle
            defaultOpen={import.meta.env.DEV}
            displayHeading={subheadingDisplayHeading}
            heading={3}
            id="button-embedded-icons-preview"
        >
            <Fragment slot='button' set:text='Button Embedded Icons Preview' />
            <ul class='tokens-demo-all-icons-inline tokens-demo-all-icons-inline--buttons tokens-demo-all-icons-inline--buttons-embedded'>
                {iconsSortedByLabel.map(([__key,icon]) => (
                    <li>
                        <span
                            class='screen-reader-text'
                            set:text={icon.slug}
                        />
                        <ul class='button-span tokens-demo-all-icons-inline--icon-list'>

                            <li>
                                <a
                                    aria-label={icon.label} 
                                    class='button'
                                    href='#'
                                ><Icon icon={icon} /></a>
                            </li>

                            <li>
                                <a
                                    class='button'
                                    href='#'
                                ><Icon icon={icon} /><span set:text={`${icon.label} Before`} /></a>
                            </li>

                            <li>
                                <a
                                    class='button'
                                    href='#'
                                ><span set:text={`${icon.label} After`} /><Icon icon={icon} /></a>
                            </li>
                        </ul>
                    </li>
                    
                ))}
            </ul>
        </Toggle>
    )
}

<Heading
    heading={2}
    set:text='All Alert Blocks'
/>
<div class='site-width | tokens-demo-all-alerts'>
    {
        iconsSortedByLabel.map(([__key,icon]) => (
            <Alert icon={icon}>
                <span
                    slot='headline'
                    set:text={icon.label}
                />
                <p>slug: <samp set:text={icon.slug} /></p>
                { icon.meta?.aliasOf && <p class="aside">is a copy of <samp set:text={icon.meta.aliasOf} /></p> }
            </Alert>
        ))
    }
</div>

<Toggle
    defaultOpen={defaultToggleToOpen}
    displayHeading={subheadingDisplayHeading}
    heading={3}
    id={`tokens-demo-alert-headings`}
>
    <Fragment
        set:text='All Alert Heading Levels'
        slot='button'
    />
    {
        Object.keys(tokens.typography.size.heading)
            .map(Number)
            .map((heading) => (
                <Alert
                    heading={heading}
                    minimumHeading={1}
                    icon={defaultIconSvg}
                >
                    <span
                        slot='headline'
                        set:text={`Heading Level ${heading}`}
                    />
                    <p set:text='Aenean dictum commodo ex, eleifend malesuada nibh rhoncus at. Vivamus non lectus eu turpis aliquet pretium. Cras metus urna, tincidunt at scelerisque sit amet, tincidunt vitae risus.' />
                    <p set:text='Vivamus sed commodo ligula, nec efficitur elit. Praesent condimentum diam est, sit amet venenatis sapien ullamcorper sit amet.' />
                </Alert>
            ))
    }
    <Alert icon={defaultIconSvg}>
        <span
            slot='headline'
            set:text={`NO Heading Level`}
        />
        <p
            set:text='Aenean dictum commodo ex, eleifend malesuada nibh rhoncus at. Vivamus non lectus eu turpis aliquet pretium. Cras metus urna, tincidunt at scelerisque sit amet, tincidunt vitae risus.'
        />
        <p
            set:text='Vivamus sed commodo ligula, nec efficitur elit. Praesent condimentum diam est, sit amet venenatis sapien ullamcorper sit amet.'
        />
    </Alert>
</Toggle>

<Toggle
    defaultOpen={defaultToggleToOpen}
    displayHeading={subheadingDisplayHeading}
    heading={3}
    id={`tokens-demo-alert-colours`}
>
    <Fragment
        set:text='All Colour Variations'
        slot='button'
    />
    <Alert icon={defaultIconSvg}>
        <span
            slot='headline'
            set:text={`Default Colour Variation`}
        />
        <LoremIpsum superAbbreviated={true} />
    </Alert>
    {
        textAndBackgroundKeys.map((key) => (
            <Alert
                icon={tokens.icons[key] ?? defaultIconSvg}
                class:list={`background-${key}`}
            >
                <span slot='headline'>
                    Colour Variation: <samp set:text={key} />
                </span>
                <LoremIpsum superAbbreviated={true} />
            </Alert>
        ))
    }
</Toggle>

<style lang='scss'>
    @forward '../scss/page-content-icons';
</style>
