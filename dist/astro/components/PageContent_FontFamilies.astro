---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { PartialExcept } from '@maddimathon/utility-typescript/types';
import type { ToggleProps } from '@maddimathon/utility-astro/components';

import type { WholeTokenLevel } from '../../ts/02-tokens/@types.d.ts';

/* import - functions */
import { 
    arrayUnique,
    objectMap,
    toTitleCase,
} from '@maddimathon/utility-typescript';

import { objectGenerator } from '../../ts/01-utilities/objectGenerator.js';
 
/* import - values */
import { Tokens } from '../../ts/02-tokens/Tokens.js'; 
import { Tokens_Typography } from '../../ts/02-tokens/Tokens_Typography.js';

/* import - components */
import {
    Heading,
} from '@maddimathon/utility-astro/components';

import Toggle from './Toggle.astro';

/* import - layouts */

/* PROPS ===================================== */

interface Props {
    tokens: Tokens.JsonReturn;

    /**
     * @since 0.1.0-beta.0.draft
     */
    ToggleComponent?: ( props: PartialExcept<ToggleProps,  'children'|'id' > ) => any;
}

const { tokens, ToggleComponent = Toggle }: Props = Astro.props;

/* FUNCTIONS ===================================== */

function detailsMapper( font: Tokens_Typography.Font.Family<string> ) {

    return Object.values( objectMap(
        font,
        ( [key, value] ) => {

            // returns on match
            switch (key) {

                case 'name':
                    return { 
                        key: toTitleCase(key),
                        value,
                    };

                case 'appendSystemFontsToFallbacks':
                case 'fontOverrideOption':
                case 'printFontFace':
                case 'display':
                case 'weights':
                    return false;

                case 'contentWidthScale':
                    return import.meta.env.DEV ? {
                        key: 'Content Width Scale',
                        value,
                    } : false;
 
                case 'fallbacks':
                    if(Array.isArray(value) ) {
                        return value.length ? {
                            key: 'Fallbacks',
                            value: value.join(', '),
                        } : false;
                    } else if (!value) {
                        return false;
                    }
                    break;

                case 'fontOverrideOption':
                    return import.meta.env.DEV ? {
                        key: 'Font Override Option',
                        value,
                    } : false;

                case 'lineGapOverride':
                    return import.meta.env.DEV ? {
                        key: 'Line Gap Override',
                        value,
                    } : false;

                case 'lineHeightScale':
                    return import.meta.env.DEV ? {
                        key: 'Line Height Scale',
                        value,
                    } : false;

                case 'sizeAdjust':
                    return {
                        key: 'Relative Size',
                        value,
                    };

                case 'slug':
                    return {
                        key: 'Role',
                        value,
                    };

                case 'unicodeRange':
                    return {
                        key: 'Unicode Range',
                        value,
                    };
            }
                
            return false;
        }
    ) ).filter( v => v !== false );
}

/* CONSTANTS ===================================== */

const defaultToggleToOpen = import.meta.env.DEV ? true : undefined;

const fontTokens = tokens.typography.fonts 
    ? Object.keys(tokens.typography.fonts).filter( v => v != 'dyslexic') 
    : [] ;

const sortedFontKeys = arrayUnique(
    (
        [
            'heading',
            'body',
            'monospace',
            'hyperlegible',
            'serif',
            ...fontTokens,
            'dyslexic',
        ] as const
    ).filter( key => !tokens.typography.fonts || key in tokens.typography.fonts )
);

const sortedFonts = tokens.typography.fonts && objectGenerator(
    sortedFontKeys,
    (key) => tokens.typography.fonts && tokens.typography.fonts[key]
) as typeof tokens.typography.fonts;

let allFontLevels = tokens.typography.fonts && arrayUnique(
    Object.values(tokens.typography.fonts)
        .map( ( { weights, variable } ) => (
            variable
                ? Tokens.Typography.Font.allWeights
                : Object.keys(weights) as WholeTokenLevel[]
        ) )
        .flat()
).sort();

if ( ! import.meta.env.DEV && allFontLevels ) {
    allFontLevels = allFontLevels.filter( 
        level => level != '100' && level != '200'
    );
}
---

<ToggleComponent
    defaultOpen={defaultToggleToOpen}
    heading={2}
    id='sizes'
>
    <Fragment slot='button'>Font Families</Fragment>
    <div 
        class='font-family-swatch-list'
        style={tokens.typography.fonts && `--font-family-list-column-count: ${Object.keys( tokens.typography.fonts ).filter(slug => slug !== 'icons').length}`}
    >
        {
           sortedFonts && Object.values(sortedFonts).map((font) => font.slug !== 'icons' && (
                <article 
                    class='font-family-swatch'
                    data-font-family-override={font.slug}
                    style={ [
                        `--font-family-swatch-family: var(--ff-${font.slug}, "${font.name}")`,
                        'font-family: var(--font-family-swatch-family) !important',
                    ].join(';') }
                >
                    <div class="font-family-swatch__intro">
                        <h3
                            class:list={['font-family-swatch__name']}
                            set:text={font.name}
                        />
                        <dl class='font-family-swatch__details-list'>
                            { detailsMapper(font).map( ( {key, value} ) => (
                                <dt
                                    class:list={[ 'h7', '|', 'font-family-swatch__details-dt' ]}
                                    set:text={key} 
                                />
                                <dd
                                    class:list={[ 'font-family-swatch__details-dd' ]}
                                    set:text={value}
                                />
                            ) ) }
                        </dl>
                    </div>
                    {allFontLevels && allFontLevels.map(( weight ) => ( font.weights[weight] || font.variable ) && ( [ 'normal', 'italic' ] as const ).map( style => (
                        <Heading
                            heading={4}
                            displayHeading={6}

                            class:list={[
                                'font-family-swatch__weight-dt',
                                `font-family-swatch__weight-dt--${ style == 'italic' ? `${weight}-${style}` : weight }`, 
                            ]}
                            style={ [
                                `font-style: ${style}`,
                                `font-weight: ${weight}`,
                            ].join(';') }
                        >{style === 'italic' ? (
                            <em set:text={`${weight} (${style})`} />
                        ) : (
                            <Fragment set:text={weight} />
                        )}</Heading>
                        <p
                            class:list={[
                                'font-family-swatch__weight-dd',
                                `font-family-swatch__weight-dd--${ style == 'italic' ? `${weight}-${style}` : weight }`,
                            ]}
                            style={ [ 
                                `--line-clamp: ${ import.meta.env.DEV ? 5 : 3 }`,
                                `font-style: ${style}`,
                                `font-weight: ${weight}`,
                            ].join(';') }
                           
                        >{style === 'italic' ? (
                            <em set:text={`Maecenas facilisis sollicitudin nisi, eget pellentesque dui rhoncus condimentum. Vivamus vulputate nisl sit amet vehicula commodo. Suspendisse pharetra varius ipsum, sed scelerisque ipsum tempor eget. Curabitur mollis lacus eu augue vestibulum semper. Praesent rutrum velit sodales ante varius convallis. Proin ut gravida sem. Nulla ac sapien odio. Cras neque arcu, fermentum non elementum ac, tincidunt ut nibh. Proin blandit, nisl at volutpat pulvinar, massa nisl vulputate risus, eget porttitor neque mi id augue. Integer porttitor egestas facilisis. Quisque eget nibh hendrerit, ornare nisl sit amet, faucibus enim.`} />
                        ) : (
                            <Fragment set:text={`Maecenas facilisis sollicitudin nisi, eget pellentesque dui rhoncus condimentum. Vivamus vulputate nisl sit amet vehicula commodo. Suspendisse pharetra varius ipsum, sed scelerisque ipsum tempor eget. Curabitur mollis lacus eu augue vestibulum semper. Praesent rutrum velit sodales ante varius convallis. Proin ut gravida sem. Nulla ac sapien odio. Cras neque arcu, fermentum non elementum ac, tincidunt ut nibh. Proin blandit, nisl at volutpat pulvinar, massa nisl vulputate risus, eget porttitor neque mi id augue. Integer porttitor egestas facilisis. Quisque eget nibh hendrerit, ornare nisl sit amet, faucibus enim.`} />
                        )}</p>
                    ) ))}
                </article>
            ))
        }
    </div>
</ToggleComponent>

<style lang='scss'>
    @forward '../scss/page-content-font-families';
</style>
