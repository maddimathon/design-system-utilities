---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    PartialExcept,
    PartialPick,
} from '@maddimathon/utility-typescript/types';

import type { LoremIpsumProps as UtilsLoremIpsumProps } from '@maddimathon/utility-astro/components';

import type { AlertComponentType } from './Alert.astro';
import type { WidgetComponentType } from './Widget.astro';

/* import - functions */
import { Tokens } from '../../ts/02-tokens/Tokens.js';
import { SampleTokens_Json } from '../functions/SampleTokens.js';

/* import - values */

/* import - components */
import {
    Heading as HeadingComponent,
    LoremIpsum as LoremIpsumUtils,
} from '@maddimathon/utility-astro/components';

import AlertComponent from './Alert.astro';
import ToggleComponent from './Toggle.astro';
import WidgetComponent from './Widget.astro';

/* import - layouts */

/* PROPS ===================================== */

export interface LoremIpsumProps extends Omit<
    UtilsLoremIpsumProps,
    'components' | 'displaySettings'
> {
    components?: Partial<LoremIpsumProps.Components>;

    displaySettings?: Omit<
        NonNullable<UtilsLoremIpsumProps['displaySettings']>,
        'buttonVariations' | 'headingLevels'
    > & {
        alerts?: boolean;
        alertsAll?: boolean;
        buttons?: boolean;
    };

    backgroundVariations?: string[];
    backgroundVariationsExtra?: string[];

    tokens?: Tokens.JsonReturn;
}

/**
 * @since 0.1.0-beta.3
 */
export namespace LoremIpsumProps {
    /**
     * @since 0.1.0-beta.3
     */
    export type Components = PartialExcept<
        Omit<UtilsLoremIpsumProps.Components, 'Alert'>,
        'Heading' | 'Toggle'
    > & {
        Alert: AlertComponentType;
        Widget: WidgetComponentType;
    };
}

type Props = LoremIpsumProps;

export type LoremIpsumComponentType = (
    props: PartialPick<LoremIpsumProps, 'tokens'>,
) => any;

const {
    displaySettings = {},
    tokens = SampleTokens_Json,
    components: inputComponents = {},

    backgroundVariations = Object.entries(
        tokens.themes.default.light.average.data.background,
    ).map(([slug, value]) => (slug === '$' ? ('default' as const) : slug)),

    backgroundVariationsExtra = [],

    ...props
}: Props = Astro.props;

const components = {
    ...inputComponents,

    Alert: inputComponents.Alert ?? AlertComponent,
    Heading: inputComponents.Heading ?? HeadingComponent,
    Toggle: inputComponents.Toggle ?? ToggleComponent,
    Widget: inputComponents.Widget ?? WidgetComponent,
} satisfies LoremIpsumProps.Components;

const { Alert, Heading } = components;

/* CONSTANTS ===================================== */

const abbreviated = props.abbreviated || props.superAbbreviated;

const isFancy = props.mode === 'fancy';
const isLibrary = isFancy || props.mode === 'library';

const headingLevels = Object.keys(tokens.typography.size.heading).map(Number);

const buttonVariations = tokens.themes['default']
    ? Object.keys(tokens.themes['default'].light['average'].data.button)
    : [];

const includeButtons = displaySettings.buttons ?? !!buttonVariations.length;

const showAllAlertVariations =
    displaySettings.alertsAll || isFancy || (isLibrary && !abbreviated);

const alertVariations = displaySettings.alerts
    ? showAllAlertVariations
        ? backgroundVariations.concat(backgroundVariationsExtra)
        : backgroundVariations
              .concat(backgroundVariationsExtra)
              .filter(
                  ([backgroundSlug]) =>
                      backgroundSlug === 'primary' ||
                      backgroundSlug === 'secondary' ||
                      backgroundSlug === 'tertiary',
              )
    : [];

const tocExtraItems = Array.isArray(displaySettings.tocExtraItems)
    ? {
          $: displaySettings.tocExtraItems,
          four: [],
      }
    : { four: [], ...(displaySettings.tocExtraItems ?? {}) };

const disclaimerHTML = (await Astro.slots.render('disclaimer'))?.trim();

if (alertVariations.length > 1) {
    tocExtraItems.four.push({ label: 'Alert Blocks', id: 'alerts' });
}
---

<section
    class='display-contents'
    aria-label='Visual styles preview'
>
    <LoremIpsumUtils
        {...props}
        asSection={false}
        components={components}
        displaySettings={{
            ...displaySettings,
            buttonVariations: includeButtons ? buttonVariations : [],
            headingLevels,
            tocExtraItems,
        }}
        toggleProps={{ tokens }}
    >
        {
            !disclaimerHTML && (
                <Heading
                    heading={2}
                    slot='disclaimer'
                    class='screen-reader-text'
                >
                    The content of this section is likely only useful for users
                    navigating visually. Most of the text is nonsense (it is a
                    type of placeholder text called Lorem Ipsum, meant to look
                    like fake latin) and exits only to demonstrate the visual
                    styling of the page. None of the visual styles are described
                    in this section.
                </Heading>
            )
        }
        <Fragment
            slot='disclaimer'
            set:html={disclaimerHTML}
        />

        <slot />

        <slot
            name='one'
            slot='one'
        />
        <slot
            name='two'
            slot='two'
        />
        <slot
            name='three'
            slot='three'
        />

        {
            alertVariations.length > 1 && (
                <Fragment slot='four'>
                    <a name='alerts' />
                    {alertVariations.map((backgroundSlug) => (
                        <Alert
                            class:list={`alert-block--${backgroundSlug in tokens.icons ? backgroundSlug : 'star'} background-${backgroundSlug}`}
                            icon={
                                tokens.icons[backgroundSlug] ??
                                tokens.icons.star
                            }
                        >
                            <Fragment slot='headline'>
                                Alert Block:{' '}
                                <samp
                                    set:text={`background-${backgroundSlug}`}
                                />
                            </Fragment>
                            <LoremIpsumUtils
                                components={components}
                                displaySettings={{
                                    buttonVariations,
                                    headingLevels,
                                }}
                                displayHeading={7}
                                heading={5}
                                mode={
                                    import.meta.env.DEV ? 'library' : 'minimum'
                                }
                                superAbbreviated={true}
                            />
                        </Alert>
                    ))}
                    <slot slot='alerts' />
                </Fragment>
            )
        }

        <slot
            name='four'
            slot='four'
        />
    </LoremIpsumUtils>
</section>
