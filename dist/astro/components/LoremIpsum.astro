---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */

/* import - functions */
import type { ComponentProps } from 'astro/types';
import type { LoremIpsumProps as UtilsLoremIpsumProps } from '@maddimathon/utility-astro/components';

import { Tokens } from '../../ts/02-tokens/Tokens.js';
import { SampleTokens_Json } from '../functions/SampleTokens.js';

/* import - values */

/* import - components */
import { LoremIpsum as LoremIpsumUtils } from '@maddimathon/utility-astro/components';
import Alert from './Alert.astro';

/* import - layouts */

/* PROPS ===================================== */

export interface LoremIpsumProps extends Omit<
    ComponentProps<typeof LoremIpsumUtils>,
    'displaySettings'
> {
    displaySettings?: Omit<
        NonNullable<UtilsLoremIpsumProps['displaySettings']>,
        'buttonVariations' | 'headingLevels'
    > & {
        alerts?: boolean;
        alertsAll?: boolean;
        buttons?: boolean;
    };
    tokens?: Tokens.JsonReturn;
}

type Props = LoremIpsumProps;

const {
    displaySettings = {},
    tokens = SampleTokens_Json,
    ...props
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const abbreviated = props.abbreviated || props.superAbbreviated;

const isFancy = props.mode === 'fancy';
const isLibrary = isFancy || props.mode === 'library';

const headingLevels = Object.keys(tokens.typography.size.heading).map(Number);

const buttonVariations = tokens.themes['default']
    ? Object.keys(tokens.themes['default'].light['average'].data.button)
    : [];

const includeButtons = displaySettings.buttons ?? !!buttonVariations.length;

const backgroundVariations = Object.entries(
    tokens.themes.default.light.average.data.background,
).map(([slug, value]) => [slug === '$' ? 'default' : slug, value] as const);

const showAllAlertVariations =
    displaySettings.alertsAll || isFancy || (isLibrary && !abbreviated);

const alertVariations =
    displaySettings.alerts && showAllAlertVariations
        ? showAllAlertVariations
            ? backgroundVariations
            : backgroundVariations.filter(
                  ([backgroundSlug]) =>
                      backgroundSlug === 'primary' ||
                      backgroundSlug === 'secondary' ||
                      backgroundSlug === 'tertiary',
              )
        : [];
---

<LoremIpsumUtils
    {...props}
    displaySettings={{
        ...displaySettings,
        buttonVariations: includeButtons ? buttonVariations : [],
        headingLevels,
    }}
>
    <slot />

    <slot
        name='one'
        slot='one'
    />
    <slot
        name='two'
        slot='two'
    />
    <slot
        name='three'
        slot='three'
    />

    {
        alertVariations.length > 1 && (
            <Fragment slot='four'>
                {alertVariations.map(([backgroundSlug, backgroundClrName]) => (
                    <Alert
                        class:list={`alert-block--${backgroundSlug} background-${backgroundSlug}`}
                        icon={tokens.icons[backgroundSlug] ?? tokens.icons.star}
                        style={
                            backgroundSlug !== 'default' &&
                            `background: var(--theme-background-${backgroundSlug}, var(--clr-${backgroundClrName}))`
                        }
                    >
                        <span slot='headline'>
                            Alert Block:{' '}
                            <samp set:text={`background-${backgroundSlug}`} />
                        </span>
                        <LoremIpsumUtils
                            displaySettings={{
                                buttonVariations,
                                headingLevels,
                            }}
                            displayHeading={7}
                            heading={5}
                            mode={import.meta.env.DEV ? 'library' : 'minimum'}
                            superAbbreviated={true}
                        />
                    </Alert>
                ))}
            </Fragment>
        )
    }

    <slot
        name='four'
        slot='four'
    />
</LoremIpsumUtils>
