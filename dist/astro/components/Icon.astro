---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '@maddimathon/utility-astro';
import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */
import { STYLES_ICON } from 'astro:env/client';

/* import - components */

/* import - layouts */

/* PROPS ===================================== */

export type IconProps = {
    icon: SvgMaker.JsonReturn;
    includeStyles?: boolean;
};

type Props = GenericElementProps<IconProps, 'span'>;

const {
    'aria-hidden': ariaHidden,
    'class': classList,
    icon,
    includeStyles = STYLES_ICON,
    slot,
    ...attributes
}: Props = Astro.props?.frontmatter ?? Astro.props;
---

<span
    {...attributes}
    aria-hidden={ariaHidden ? true : undefined}
    class:list={['icon', `icon--${icon.slug}`, { '||': classList }, classList]}
    set:html={icon.svgInlineLabelled.trim()}
/>{includeStyles && <style lang='scss'>@forward '../css/icon.css';</style>}
