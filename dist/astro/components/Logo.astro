---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import type {
    ClassList,
    GenericElementProps,
} from '@maddimathon/utility-astro';

/* import - layouts */

/* PROPS ===================================== */

export type LogoProps = {
    logo: SvgMaker.JsonReturn;
    class?: ClassList;
};

type Props = GenericElementProps<LogoProps, 'div'>;

const {
    logo,
    class: classList = [],
    ...attributes
}: Props = Astro.props?.frontmatter ?? Astro.props;

/* CONSTANTS ===================================== */

const { slug, svgInlineLabelled: svg } = logo;
---

<div
    {...attributes}
    class:list={[
        'brand-logo',
        `brand-logo--${slug}`,
        { '||': classList },
        classList,
    ]}
>
    <Fragment set:html={svg} />
</div>
