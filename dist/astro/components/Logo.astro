---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLTag } from 'astro/types';

import type {
    ClassList,
    GenericElementProps,
} from '@maddimathon/utility-astro';
import type { DynamicWrapperProps } from '@maddimathon/utility-astro/components';

import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import components from '@maddimathon/utility-astro/components';
const { DynamicWrapper } = components;

/* import - layouts */

/* PROPS ===================================== */

export type LogoProps<T_Tag extends HTMLTag = HTMLTag> = Omit<
    DynamicWrapperProps<T_Tag>,
    'children'
> & {
    logo: SvgMaker.JsonReturn;
    class?: ClassList;
};

type Props = GenericElementProps<LogoProps, 'div'>;

const {
    logo,
    'class': classList = [],
    'aria-hidden': ariaHidden = false,
    tag = 'div',
    ...attributes
}: Props = Astro.props?.frontmatter ?? Astro.props;

/* CONSTANTS ===================================== */
---

<DynamicWrapper
    {...attributes}
    aria-hidden={ariaHidden ? true : undefined}
    class:list={[
        'brand-logo',
        `brand-logo--${logo.slug}`,
        { '||': classList },
        classList,
    ]}
    tag={tag}
>
    <Fragment
        set:html={ariaHidden
            ? logo.svgInlineHidden.trim()
            : logo.svgInlineLabelled.trim()}
    />
</DynamicWrapper>
