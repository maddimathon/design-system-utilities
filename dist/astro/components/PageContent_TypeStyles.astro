---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { PartialExcept } from '@maddimathon/utility-typescript/types';
import type { ToggleProps } from '@maddimathon/utility-astro/components';

import type { RecursiveRecord } from '../../ts/index.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */
import { objectMap } from '@maddimathon/utility-typescript';

/* import - values */

/* import - components */
import Toggle from './Toggle.astro';

/* import - layouts */

/* PROPS ===================================== */

interface Props {
    tokens: Tokens.JsonReturn;

    /**
     * @since 0.1.0-beta.0.draft
     */
    ToggleComponent?: ( props: PartialExcept<ToggleProps,  'children'|'id' > ) => any;
}

const { tokens, ToggleComponent = Toggle }: Props = Astro.props;

/* CONSTANTS ===================================== */

const defaultToggleToOpen = import.meta.env.DEV ? true : undefined;

const headingSizes = Object.keys(tokens.typography.size.heading).map(
    Number
) as (keyof typeof tokens.typography.size.heading)[];

const sizeFlattener = (
    sizes:
        | Tokens.JsonReturn['typography']['size']
        | RecursiveRecord<number | string, number>,
    prefix?: string
) => {
    const validateKey_addPrefix = (key: number | string): string =>
        [prefix, String(key)].filter((v) => v).join('-');

    const flat: {
        [key: string]: Tokens.JsonReturn['typography']['size']['title'];
    } = {};

    for (const t_key of Object.keys(sizes)) {
        const value = sizes[t_key as keyof typeof sizes] as
            | undefined
            | (typeof flat)[string];
        const key = validateKey_addPrefix(t_key);

        // continues
        if (typeof value === 'undefined') {
            continue;
        }

        // continues
        if (typeof value !== 'object' || !value || 'rem' in value) {
            flat[key] = value;
            continue;
        }

        const flatValue = sizeFlattener(
            value as RecursiveRecord<number | string, number>,
            String(key)
        );

        for (const t_flat_childKey of Object.keys(flatValue)) {
            const _flat_childKey = t_flat_childKey as keyof typeof flatValue;

            if (typeof flatValue[_flat_childKey] !== 'undefined') {
                flat[t_flat_childKey] = flatValue[_flat_childKey];
            }
        }
    }

    return flat;
};

const flattenedSizes = objectMap(
    sizeFlattener(tokens.typography.size),
    ([ key, value ]) => {

        const headingMatches = String(key)?.match(/^heading-(\d+)$/i) as null | [ string, string ];

        return {
            name: key, 
            headingClass: headingMatches?.[1] ? `h${headingMatches[1]}` : null,
            rem: value.rem,
            sizes: Object.values(objectMap(
                value,
                ([ type, value ]) => ({
                    type,
                    value,
                })
            )),
        };
    }
);
---

<ToggleComponent
    defaultOpen={defaultToggleToOpen}
    heading={2}
    id='sizes'
>
    <Fragment slot='button'>All Sizes</Fragment>

    <dl class="typography-all-sizes">
        { Object.values(flattenedSizes).map( ({name, headingClass, rem, sizes}) => (
            <dt 
                class={headingClass}
                style={ `font-size: ${rem}rem !important` }
                set:text={name}
            />
            <dd>
                <dl class="typography-all-sizes__value-list">{sizes.map( ({ type, value }) => (
                    <div class="typography-all-sizes__value-list__pair"><dt set:text={type} />
                    <dd set:text={value} /></div>
                ) )}</dl>
            </dd>
        ) ) }
    </dl>
</ToggleComponent>

<ToggleComponent
    class:list={'site-width'}
    defaultOpen={defaultToggleToOpen}
    heading={3}
    id='compare-dynamic-sizing'
>
    <Fragment slot='button'>Compare Dynamic Sizing</Fragment>

    <dl class="typography-all-sizes typography-all-sizes--compare-dynamic">
        { Object.values(flattenedSizes).map( ({name, headingClass, rem, sizes}) => (
            <dt
                class="unstyled-heading"
                set:text={name}
            />
            <dd class="typography-all-sizes__value-list">
                <p
                    class:list={[headingClass, '|', 'typography-compare-dynamic__sample']}
                    style={ `font-size: ${rem}rem !important` }
                >Static. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed vel odio at nibh pharetra condimentum. Nam tincidunt dapibus purus, nec tempus mi tempor vitae. Mauris id sapien sodales, dignissim tortor eget, volutpat turpis.</p>
                <p
                    class:list={[headingClass, `font-size-${name}`, '|', 'typography-compare-dynamic__sample']}
                >Dynamic! Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed vel odio at nibh pharetra condimentum. Nam tincidunt dapibus purus, nec tempus mi tempor vitae. Mauris id sapien sodales, dignissim tortor eget, volutpat turpis.</p>
            </dd>
        ) ) }
    </dl>
</ToggleComponent>

<ToggleComponent
    defaultOpen={defaultToggleToOpen}
    heading={2}
    id='heading-styles'
>
    <Fragment slot='button' set:text='Heading Styles' />
    <p 
        class:list={`page-title | typography-all-headings__sample`}
        id={`page-title`}
    >Page Title (H1) – Maecenas Facilisis <a href="#">Sollicitudin Nisi</a>, Eget Pellentesque Dui Rhoncus Condimentum; Aenean Lacinia Urna Sed Lacus Interdum Faucibus; Donec Quam Erat, Sagittis id Diam a, Hendrerit Viverra Ligula; Proin Efficitur Rhoncus ex Auctor Faucibus</p>

    {
        headingSizes.map((num) => ( num > 1 ) && (
            <p 
                class:list={`h${num} | typography-all-headings__sample`}
                id={`heading-${num}`}
            >Heading {num} – Maecenas Facilisis <a href="#">Sollicitudin Nisi</a>, Eget Pellentesque Dui Rhoncus Condimentum; Aenean Lacinia Urna Sed Lacus Interdum Faucibus; Donec Quam Erat, Sagittis id Diam a, Hendrerit Viverra Ligula; Proin Efficitur Rhoncus ex Auctor Faucibus</p>
        ))
    }
</ToggleComponent>


<style lang='scss'>
    @forward '../scss/page-content-type-styles';
</style>