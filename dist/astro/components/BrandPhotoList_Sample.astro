---
/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    ButtonComponentType,
    HeadingComponentType,
} from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../ts/02-tokens/@types.d.ts';

import type { BrandPhotoList_Sample_MetadataProps } from './BrandPhotoList_Sample/index.js';

import type {
    AllPhotos,
    AllThumbnails,
    BrandPhotoComponentType,
    BrandPhotoProps,
    BrandPhotoProps_Linked,
} from './BrandPhoto.astro';

/* import - functions */

/* import - values */

/* import - components */
import BrandPhotoComponent from './BrandPhoto.astro';

import photoListComponents from './BrandPhotoList_Sample/index.js';
const { BrandPhotoList_Sample_Metadata } = photoListComponents;

/* import - layouts */

/* TYPES ===================================== */

/* PROPS ===================================== */

// prettier-ignore
interface Props<T_Types extends TokenTypes.TypeParams = TokenTypes.TypeParams> extends BrandPhotoList_Sample_MetadataProps<T_Types> {
    components?: Partial<{
        BrandPhoto: BrandPhotoComponentType;
        Button: ButtonComponentType;
        Heading: HeadingComponentType;
    }>;
    
    defineSize: undefined | boolean;
    
    photos: AllPhotos<T_Types>;
    thumbnails: AllThumbnails<T_Types>;

    urlMaker: (currentURL: URL, targetSubpath: string) => string;
}

const {
    components: { BrandPhoto = BrandPhotoComponent, ...components } = {},
    defineSize,
    displayHeading = -1,
    data,
    includeCaption = false,
    photos,
    thumbnails,
    urlMaker,
    ...metadataProps
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const linkProps = data.attrs.src
    ? ({
          href: data.attrs.src,
          linkAttrs: {
              class: [
                  'brand-photo-list__sample__img',
                  `brand-photo-list__sample__img--${data.slug}`,
                  {
                      'brand-photo-list__sample__img--hidden-heading':
                          displayHeading < 0,
                  },
              ],
              target: '_blank',
          },
          linkLabel: 'open image in new tab',
      } satisfies Pick<
          BrandPhotoProps_Linked,
          'href' | 'linkAttrs' | 'linkLabel'
      >)
    : {};

const photoProps = {
    // components,
    defineSize,
    includeCaption,
    photos,
    slug: data.slug,
    thumbnails,
    urlMaker,
    ...linkProps,

    linkAttrs: {
        ...linkProps.linkAttrs,
    },
} satisfies BrandPhotoProps;
---

<BrandPhoto {...photoProps} />

<BrandPhotoList_Sample_Metadata
    {...{
        ...metadataProps,
        components,
        displayHeading,
        data,
        includeCaption,
    }}
    class='brand-photo-list__sample__meta'
/>
