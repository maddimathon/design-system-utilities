---
import type { ClassList, ElementProps } from '@maddimathon/utility-astro';

/**
 * @since 0.1.0-beta.0
 *
 * @packageDocumentation
 */

/* import - types */
import type { HTMLAttributes } from 'astro/types';
import type {
    ButtonComponentType,
    ButtonProps_Button,
    FormFieldComponentType,
} from '@maddimathon/utility-astro/components';

import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - values */
import { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - components */
import Icon from './Icon.astro';
import {
    Button as ButtonComponent,
    FormField as FormFieldComponent,
} from '@maddimathon/utility-astro/components';

/* import - layouts */

/* TYPES ===================================== */

export type SearchFormProps = {
    buttonLabel?: string;

    button?: Omit<
        Partial<ButtonProps_Button & { class: ClassList }>,
        'aria-label' | 'aria-labelledby' | 'set:html' | 'set:text' | 'type'
    >;

    components?: Partial<{
        Button: ButtonComponentType;
        FormField: FormFieldComponentType;
    }>;

    id: string;

    inputLabel?: string;

    input?: Omit<
        HTMLAttributes<'input'>,
        'aria-label' | 'aria-labelledby' | 'placeholder' | 'style' | 'type'
    > & {
        style?: string | null | undefined;
    };

    placeholder?: string;

    searchIcon?: undefined | SvgMaker.JsonReturn;

    tokens: Tokens.JsonReturn;
};

/* PROPS ===================================== */

type Props = ElementProps<SearchFormProps, 'form'>;

const {
    button: { class: buttonClassList, ...button } = {},
    buttonLabel = 'Search',
    class: classList,
    components: {
        Button = ButtonComponent,
        FormField = FormFieldComponent,
    } = {},
    id,
    inputLabel = 'Search the site',
    input: { class: inputClassList, ...inputAttrs } = {},
    placeholder = 'Search the site…',
    tokens,
    searchIcon,
    ...attrs
}: Props = Astro.props;

/* CONSTANTS ===================================== */
---

<form
    {...attrs}
    class:list={makeClassList('search-form', classList)}
    aria-label='Search Form'
    role='search'
>
    <FormField
        {...inputAttrs}
        class={inputClassList ?? undefined}
        name='s'
        id={id}
        placeholder={placeholder}
        type='search'
        labelAttrs={{ class: 'screen-reader-text' }}
        ><Fragment slot='label'>{inputLabel}</Fragment></FormField
    >

    <Button
        {...button}
        aria-label={buttonLabel}
        class:list={makeClassList('button--no-pseudo', buttonClassList)}
        type='submit'
        ><Icon icon={searchIcon ?? tokens.icons.search} /><slot
            name='button'
        /></Button
    >
</form>
