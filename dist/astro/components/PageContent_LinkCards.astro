---
/**
 * @since 0.3.0
 *
 * @packageDocumentation
 */

/* import - types */
import type {} from '@maddimathon/utility-astro';
import type {
    HeadingComponentType,
    HeadingProps,
} from '@maddimathon/utility-astro/components';

import type { TokenTypes } from '../../ts/02-tokens/@types.js';
import type { Tokens } from '../../ts/02-tokens/Tokens.js';

import type { LinkCardComponentType } from './LinkCard.astro';
import type { SampleLinkCardComponentType } from './SampleLinkCard.astro';

/* import - functions */
import { toValidNumber } from '@maddimathon/utility-typescript';

/* import - values */

/* import - components */
import { Heading as HeadingComponent } from '@maddimathon/utility-astro/components';

import LinkCardComponent from './LinkCard.astro';
import SampleLinkCardComponent from './SampleLinkCard.astro';

/* import - layouts */
// import {} from '@maddimathon/utility-astro/layouts';

/* TYPES ===================================== */

/* PROPS ===================================== */

type Props = {
    tokens: Tokens.JsonReturn<TokenTypes.TypeParams>;

    components?: Partial<{
        Heading: HeadingComponentType;
        LinkCard: LinkCardComponentType;
        SampleLinkCard: SampleLinkCardComponentType;
    }>;

    displayHeading?: HeadingProps['displayHeading'];
    heading?: HeadingProps['heading'];
};

const {
    components: {
        Heading = HeadingComponent,
        LinkCard = LinkCardComponent,
        SampleLinkCard = SampleLinkCardComponent,
    } = {},
    displayHeading,
    heading = 2,
    tokens,
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const headingLevels = Object.keys(tokens.css.style.heading)
    .map((key) => toValidNumber(key))
    .filter((num): num is NonNullable<typeof num> => num !== null && num > 1);
---

<SampleLinkCard
    component={LinkCard}
    href='#'
    id='demo-card'
    tokens={tokens}
/>

<SampleLinkCard
    component={LinkCard}
    footer={false}
    href='#'
    id='demo-card-no-subheading'
    subheading={false}
    tokens={tokens}
/>

<Heading
    displayHeading={displayHeading}
    heading={heading}
    >Link card container</Heading
>
<div class='link-cards-container'>
    {
        Array.from({ length: import.meta.env.DEV ? 5 : 3 }).map((_, i) => (
            <SampleLinkCard
                component={LinkCard}
                href='#'
                id={`demo-card-container-${i}`}
                tokens={tokens}
            />
        ))
    }
</div>

<Heading
    class='page-width'
    displayHeading={displayHeading}
    heading={heading}
    >Link cards with headings</Heading
>
<p class='page-width'>
    These link cards are in a page-width link card container.
</p>
<div class='page-width | link-cards-container'>
    {
        headingLevels.map((heading) => (
            <SampleLinkCard
                component={LinkCard}
                displayHeading={heading}
                href='#'
                id={`demo-card-heading-${heading}`}
                tokens={tokens}
            />
        ))
    }
</div>
