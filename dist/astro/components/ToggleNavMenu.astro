---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { GenericElementProps } from '@maddimathon/utility-astro';
import type { ToggleNavMenuProps as UtilsToggleNavMenuProps } from '@maddimathon/utility-astro/components';

import type { Tokens } from '../../ts/02-tokens/Tokens.js';

/* import - functions */

/* import - values */
import { SampleTokens_Json } from '../functions/index.js';

/* import - components */
import { ToggleNavMenu as UtilsToggleNavMenu } from '@maddimathon/utility-astro/components';

/* import - layouts */

/* PROPS ===================================== */

export type ToggleNavMenuProps = UtilsToggleNavMenuProps & {
    tokens?: Tokens.JsonReturn;
};

type Props = GenericElementProps<ToggleNavMenuProps, 'div'>;

const { tokens = SampleTokens_Json, ...props }: Props = Astro.props;

/* CONSTANTS ===================================== */

const iconSVG =
    '<span class="icon icon--toggle | toggle-block__control__icon">' +
    tokens.icons.toggle.svgInlineLabelled.trim() +
    '</span>';
---

<UtilsToggleNavMenu
    {...props}
    iconSVG={iconSVG}
    ><slot
        slot='button'
        name='button'
    /></UtilsToggleNavMenu
>
