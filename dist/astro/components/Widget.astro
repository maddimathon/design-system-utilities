---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type {
    GenericDynamicWrapperProps,
    DynamicWrapperComponentType,
    HeadingComponentType,
} from '@maddimathon/utility-astro/components';

/* import - functions */
import { makeClassList } from '@maddimathon/utility-astro/functions';

/* import - values */

/* import - components */
import {
    DynamicWrapper as DynamicWrapperComponent,
    Heading as HeadingComponent,
} from '@maddimathon/utility-astro/components';

/* import - layouts */

/* PROPS ===================================== */

export type WidgetProps = GenericDynamicWrapperProps<
    {
        children: any;

        components?: Partial<{
            DynamicWrapper: DynamicWrapperComponentType;
            Heading: HeadingComponentType;
        }>;

        /**
         * If any, the heading display level override for this heading (otherwise
         * the `heading` value is used).
         */
        displayHeading?: number;

        heading: number;

        /**
         * @since 0.1.0-alpha.4
         */
        hideHeading?: boolean;

        style?: string;
    },
    'article' | 'div' | 'section' | false | null
>;

export type WidgetComponentType = (props: Omit<WidgetProps, 'wrapper'>) => any;

type Props = WidgetProps;

const {
    class: classList,
    components: {
        DynamicWrapper = DynamicWrapperComponent,
        Heading = HeadingComponent,
    } = {},
    displayHeading,
    heading,
    hideHeading = false,
    tag = 'section',
    ...attributes
}: Props = Astro.props;

/* CONSTANTS ===================================== */

const ctaButtonsHTML = (await Astro.slots.render('cta-buttons'))?.trim();

const headingHTML = (await Astro.slots.render('heading'))?.trim();

const subheadingHTML = (await Astro.slots.render('subheading'))?.trim();
---

{
    (headingHTML || subheadingHTML) && (
        <DynamicWrapper
            {...attributes}
            class:list={makeClassList('widget-block', classList)}
            tag={tag}
        >
            <slot name='prefix' />

            {headingHTML && (
                <header
                    class:list={[
                        'widget-block__header',
                        hideHeading && 'screen-reader-text',
                    ]}
                >
                    <Heading
                        attrs={{
                            hgroup: { class: 'widget-block__hgroup' },
                            subheading: { class: 'widget-block__subtitle' },
                        }}
                        class:list='widget-block__title'
                        displayHeading={displayHeading}
                        heading={heading}
                    >
                        <Fragment set:html={headingHTML} />
                        <Fragment
                            slot='subheading'
                            set:html={subheadingHTML}
                        />
                    </Heading>
                </header>
            )}

            <div class='widget-block__content'>
                <slot />
            </div>

            {ctaButtonsHTML && (
                <div
                    class='button-span | widget-block__button-span'
                    set:html={ctaButtonsHTML}
                />
            )}
        </DynamicWrapper>
    )
}
