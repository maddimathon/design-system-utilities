---
/**
 * @since 0.1.0-alpha
 *
 * @packageDocumentation
 */

/* import - types */
import type { ComponentProps } from 'astro/types';
import type { ElementProps } from '@maddimathon/utility-astro';

import type {
    AlertProps as UtilsAlertProps,
    AlertIconProps_Render,
} from '@maddimathon/utility-astro/components';

import type { SvgMaker } from '../../ts/01-utilities/SvgMaker.js';

/* import - functions */

/* import - values */

/* import - components */
import { Alert as UtilsAlert } from '@maddimathon/utility-astro/components';
import Icon from './Icon.astro';
import type { PartialPick } from '@maddimathon/utility-typescript/types';

/* import - layouts */

/* PROPS ===================================== */

export type AlertProps = ElementProps<
    UtilsAlertProps<AlertIconProps_Render> & {
        icon: SvgMaker.JsonReturn;
    },
    'section'
>;

type Props = AlertProps;

export type AlertComponentType =
    | ((props: Omit<AlertProps, 'icon'> & { icon?: any }) => any)
    | ((props: PartialPick<AlertProps, 'icon'>) => any)
    | ((props: AlertProps) => any);

const { icon, class: classList = [], ...props } = Astro.props as Props;

/* CONSTANTS ===================================== */

const utilsProps = {
    ...props,
    slug: icon.slug,
} as unknown as ComponentProps<typeof UtilsAlert> & {};
---

{/* @ts-ignore */}
<UtilsAlert
    {...utilsProps}
    class:list={[
        {
            'alert-block--has-heading': props.heading,
            '||': classList,
        },
        classList,
    ]}
>
    <Icon
        slot='icon'
        icon={icon}
    />
    <slot
        slot='headline'
        name='headline'
    />
    <slot />
</UtilsAlert>
